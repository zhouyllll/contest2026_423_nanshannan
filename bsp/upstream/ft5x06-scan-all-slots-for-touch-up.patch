+/****************************************************************************
+ * Name: ft5x06_decode
+ *
+ * Description:
+ *   把原始缓冲解成统一的触点列表，同时支持两代 FocalTech 协议。
+ *
+ * ★ 为什么需要它
+ *
+ *   这个驱动原本只认 FT5x06 那一代的数据排布。较新的 FT8xxx（本项目上
+ *   板的是 FT8756）用的是厂商称为 protocol v2 的排布，两者在同一个寄存器
+ *   地址上返回**完全不同的结构**：
+ *
+ *                     老协议(FT5x06)          v2(FT8756)
+ *     触点数          buf[1] 整字节           buf[1] & 0x0F
+ *     协议标识        —                       buf[1] >> 4 == 0x02
+ *     每点长度        6 字节                  8 字节
+ *     首点偏移        2                       4
+ *     坐标位宽        12 位                   16 位（低 4 位在 PRE 的高半字节）
+ *
+ *   最要命的是第一行：v2 的 buf[1] 高 4 位是协议号 0x2，老代码把整个字节
+ *   当触点数，读出来是 0x2N ≥ 32，超过 FT5X06_MAX_TOUCHES，于是**整帧被
+ *   当成无效丢掉**。表现是中断照常进（实测 2772 次）、/dev/input0 却一个
+ *   字节都读不出来 —— 两边都不报错，很难往协议版本上想。
+ *
+ *   出处：kernel-6.1 drivers/input/touchscreen/focaltech_touch_ft8756/
+ *         focaltech_core.c 的 fts_read_touchdata_i2c() 与 v2 解析分支。
+ *
+ ****************************************************************************/
+
+/* 原厂 focaltech_core.h: #define FTS_MAX_ID 0x0A —— 槽位 ID 的有效上界 */
+
+#define FT5X06_FTS_MAX_ID  0x0a
+
+#define FT5X06_PROTO_V2        0x02
+#define FT5X06_V2_HDRLEN       4
+#define FT5X06_V2_TCHLEN       8
+
+struct ft5x06_decoded_s
+{
+  uint8_t  id;
+  uint8_t  event;
+  uint16_t x;
+  uint16_t y;
+};
+
+static int ft5x06_decode(FAR const uint8_t *buf,
+                         FAR struct ft5x06_decoded_s *out, int max)
+{
+  int n;
+  int i;
+
+  if ((buf[1] >> 4) == FT5X06_PROTO_V2)
+    {
+      n = buf[1] & 0x0f;
+
+      /* 缓冲能放下多少点，取决于 FT5X06_TOUCH_DATA_LEN。多出来的点这一帧
+       * 看不到 —— 对只用单点的上层没有影响，但要说清楚而不是静默截断。
+       */
+
+      if (n > (FT5X06_TOUCH_DATA_LEN - FT5X06_V2_HDRLEN) / FT5X06_V2_TCHLEN)
+        {
+          n = (FT5X06_TOUCH_DATA_LEN - FT5X06_V2_HDRLEN) / FT5X06_V2_TCHLEN;
+        }
+
+      if (n > max)
+        {
+          n = max;
+        }
+
+      for (i = 0; i < n; i++)
+        {
+          FAR const uint8_t *p = buf + FT5X06_V2_HDRLEN + i * FT5X06_V2_TCHLEN;
+
+          out[i].event = p[0] >> 6;
+          out[i].id    = p[2] >> 4;
+          out[i].x     = (uint16_t)(((p[0] & 0x0f) << 12) |
+                                    (p[1] << 4) | ((p[4] >> 4) & 0x0f));
+          out[i].y     = (uint16_t)(((p[2] & 0x0f) << 12) |
+                                    (p[3] << 4) | (p[4] & 0x0f));
+        }
+
+      return n;
+    }
+
+  /* 老协议
+   *
+   * ★ 扫**所有槽位**，不要只扫 buf[1]（TD_STATUS）个。
+   *
+   *   出处：原厂 focaltech_touch/focaltech_core.c fts_read_parse_touchdata()
+   *
+   *     for (i = 0; i < max_touch_num; i++) {
+   *         pointid = (buf[FTS_TOUCH_ID_POS + base]) >> 4;
+   *         if (pointid >= FTS_MAX_ID) break;
+   *         ...
+   *         events[i].flag = buf[FTS_TOUCH_EVENT_POS + base] >> 6;
+   *     }
+   *
+   *   它的循环上界是 max_touch_num，**完全不看 point_num**，终止条件是
+   *   "槽位里的 ID 无效"。
+   *
+   *   为什么这很关键：手指抬起来那一帧，控制器报的是 TD_STATUS = 0，
+   *   但槽位 0 里**仍然有一条带 UP 事件的记录**。只按 TD_STATUS 扫，
+   *   这一帧就什么都读不到 —— 上层永远收不到 TOUCH_UP，LVGL 的指针
+   *   一直停在 PRESSED，于是"按下有反应、松开没有"，而点一下切页需要的
+   *   恰恰是完整的按下+松开。板上现象就是"点了一点反应都没有"。
+   *
+   *   FTS_MAX_ID 在原厂头文件里是 0x0A。
+   */
+
+  n = 0;
+  for (i = 0; i < max && i < FT5X06_MAX_TOUCHES; i++)
+    {
+      FAR const uint8_t *p = buf + 2 + i * 6;
+      uint8_t            id = p[2] >> 4;
+
+      if (id >= FT5X06_FTS_MAX_ID)
+        {
+          break;                 /* 槽位无效，后面的也不用看了 */
+        }
+
+      out[n].event = p[0] >> 6;
+      out[n].id    = id;
+      out[n].x     = (uint16_t)(((p[0] & 0x0f) << 8) | p[1]);
+      out[n].y     = (uint16_t)(((p[2] & 0x0f) << 8) | p[3]);
+      n++;
+    }
+
+  return n;
+}
