+/* ★ 诊断计数器（排查"中断进来了但上层拿不到数据"用）
+ *
+ *   这一条链有四个可能断点：worker 没被调度、I2C 读失败、解码判无效、
+ *   样本交付了但上层不认。串口日志在中断上下文里既会改变时序、又会被
+ *   1.5M 无流控的串口丢掉，所以用计数器：事后从容读，不影响时序。
+ */
+
+uint32_t g_ft5x06_workers;      /* worker 跑了几次           */
+uint32_t g_ft5x06_reads;        /* I2C 读成功几次            */
+uint32_t g_ft5x06_valids;       /* 解码判为有效几次          */
+uint32_t g_ft5x06_delivered;    /* 真正交付给上层几个样本    */
+uint32_t g_ft5x06_lastraw;      /* 最近一帧的 buf[0..3]      */
+uint32_t g_ft5x06_lastxy;       /* 最近一个点 (x<<16)|y      */
