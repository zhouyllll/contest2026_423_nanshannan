 /* ── Clock-safe elapsed time calculation ───────────────────── */
 
+/* Read a monotonic timestamp into a struct timeval.
+ *
+ * ★ Elapsed time MUST NOT come from gettimeofday() here.
+ *
+ *   vela_tls.c calls clock_settime(CLOCK_REALTIME, ...) before the
+ *   handshake when the wall clock is older than the server certificate's
+ *   validity window ("Clock too old, forcing to ..."). The LLM start
+ *   timestamp is taken before that jump and the end timestamp after it,
+ *   so their difference is the size of the jump -- observed on real
+ *   hardware as "LLM watchdog: call took 2747053661 ms (limit 60s)",
+ *   which made the watchdog discard a response that had in fact already
+ *   arrived successfully ("Response: 72 bytes text").
+ *
+ *   A monotonic clock is immune to that, and to any other wall-clock
+ *   adjustment (NTP, manual date setting) landing mid-call. Every use of
+ *   these timestamps in this file is a start/end difference, so none of
+ *   them wants wall-clock time in the first place.
+ */
+
+static void mono_timeofday(struct timeval* tv)
+{
+    struct timespec ts;
+
+    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) {
+        /* Should not happen. Report zero rather than a garbage latency
+         * that would trip the watchdog. */
+        tv->tv_sec = 0;
+        tv->tv_usec = 0;
+        return;
+    }
+
+    tv->tv_sec = ts.tv_sec;
+    tv->tv_usec = ts.tv_nsec / 1000;
+}
+
 static inline uint32_t calc_elapsed_ms(const struct timeval* t0,
     const struct timeval* t1)
 {
