-#define GMAC0_CLK25M_BANK  3
-#define GMAC0_CLK25M_PIN   4
-#define GMAC0_CLK25M_FUNC  3
-#define GMAC1_CLK25M_BANK  2
-#define GMAC1_CLK25M_PIN   30
-#define GMAC1_CLK25M_FUNC  2
