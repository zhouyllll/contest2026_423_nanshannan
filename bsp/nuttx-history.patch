-
-/* 内部上下拉的取值（PULL_TYPE_IO_DEFAULT 编码） */
-
-#define RK3576_PULL_NONE     0
-#define RK3576_PULL_UP       1
-#define RK3576_PULL_DOWN     2
-#define RK3576_PULL_HOLD     3
-
-/****************************************************************************
- * Name: rk3576_pinmux_setpull
