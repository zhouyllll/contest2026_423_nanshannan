-#define GMAC0_CLK25M_BANK_ALT  2
-#define GMAC0_CLK25M_PIN_ALT   31
-#define GMAC0_CLK25M_FUNC_ALT  3
-#define GMAC1_CLK25M_BANK_ALT  1
-#define GMAC1_CLK25M_PIN_ALT   29
-#define GMAC1_CLK25M_FUNC_ALT  1
