From 0a1e36e81c91e0afe144f6b59147cf68582801ed Mon Sep 17 00:00:00 2001
From: zhouyllll <xuezhou28@gmail.com>
Date: Sat, 5 Sep 2026 00:04:04 +0800
Subject: [PATCH 35/49] arch/arm64/rk3576: bound the CIF DMA with the
 frame-size register

The CIF driver programmed the stride and the buffer addresses but never
told the hardware how tall the frame is, on the reasoning that RK3576
has no such register and lets the DMA follow the stream.  That was
wrong.  The DMA never learned where to stop, ran past the kmm buffer and
corrupted the heap free list; the failure then surfaced in whatever ran
next -- a data abort inside mm_malloc, reached from nsh spawning a task,
with nothing in the backtrace pointing at the camera at all.

Rockchip's kernel says RK3576 only moved the register:

  if (dev->chip_id < CHIP_RK3576_CIF)
      write(get_reg_index_of_id_ctrl1(id), width | height << 16);
  else
      write(CIF_REG_MIPI_SET_SIZE_ID0 + id, width | height << 16);

  regs.h: CSI_MIPI0_SET_FRAME_SIZE_ID0_RK3576 = 0x1A0
          CSI_MIPI0_ID0_CROP_START_RK3576     = 0x190

So write the size at 0x1A0, the crop origin at 0x190, and set CROP_EN,
which the vendor enables unconditionally on RK3576 and which the size
register depends on.  The original observation that CTRL1 holds vc/dt
rather than the geometry was correct; the conclusion drawn from it --
that no geometry register exists -- was not.

Verified on the board: `cam cap` followed by `cam fbinfo` and `free`
both survive, where before the next allocation aborted.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01R8x2gNA2B8dB1TSCrtBacm
---
 arch/arm64/src/rk3576/rk3576_cif.c | 40 +++++++++++++++++++++++++++---
 1 file changed, 37 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/src/rk3576/rk3576_cif.c b/arch/arm64/src/rk3576/rk3576_cif.c
index d62ebb8b..046bb771 100644
--- a/arch/arm64/src/rk3576/rk3576_cif.c
+++ b/arch/arm64/src/rk3576/rk3576_cif.c
@@ -111,13 +111,34 @@
  *   布局。RK3576 的 CTRL1 是虚通道(1:0)与数据类型(7:2)；把宽高写进去
  *   等于设了个乱数据类型、还顺手开了 HDR 模式。
  *
- *   RK3576 压根没有宽高寄存器 —— GLB_CTRL 的 sw_dma_adapt_en 复位即为
- *   1，DMA 按数据流的实际尺寸搬运，只需给跨距(VLW)和缓冲地址。
+ *   ★ 但"CTRL1 不是宽高寄存器"不等于"没有宽高寄存器"。
+ *
+ *     这里原先据此推断 RK3576 靠 DMA 自适应、只要跨距和地址就够了。
+ *     那是错的，而且错得很贵：DMA 不知道该在第几行收手，就一直往下写，
+ *     冲出 kmm 分配的那块缓冲、踩烂堆的空闲链表。现象是**下一条要
+ *     malloc 的命令**崩在 mm_malloc 里 —— 崩的地方离肇事者十万八千里。
+ *
+ *     厂商内核 capture.c 里写得很清楚，RK3576 只是把这个寄存器挪了地方：
+ *
+ *       if (dev->chip_id < CHIP_RK3576_CIF)
+ *           write(get_reg_index_of_id_ctrl1(id), width | height << 16);
+ *       else
+ *           write(CIF_REG_MIPI_SET_SIZE_ID0 + id, width | height << 16);
+ *
+ *     regs.h: CSI_MIPI0_SET_FRAME_SIZE_ID0_RK3576 = 0x1A0
+ *             CSI_MIPI0_ID0_CROP_START_RK3576     = 0x190
  */
 
 #define CIF_ID_VC_SHIFT          0            /* sw_vc_id0, 2 位 */
 #define CIF_ID_DT_SHIFT          2            /* sw_dt_id0, 6 位 */
 
+/* RK3576 专有：裁剪起点与帧尺寸。厂商在 RK3576 上无条件开 CROP_EN
+ * 并写这两个寄存器，DMA 的搬运边界就是由它们定的。
+ */
+
+#define CIF_MIPI_ID0_CROP_START  0x190
+#define CIF_MIPI_SET_SIZE_ID0    0x1a0
+
 /* 通路级控制 VICAP_MIPIn_CTRL：bit0 是这条通路的总开关，复位为 0。
  * 不置位的话各 id 自己的 cap_en 都不起作用。
  */
@@ -236,6 +257,19 @@ int rk3576_cif_start(int host, uintptr_t buf0, uintptr_t buf1,
              (0u << CIF_ID_VC_SHIFT) |
              ((uint32_t)MIPI_CSI2_DT_RAW12 << CIF_ID_DT_SHIFT));
 
+  /* ★ 帧尺寸必须写，它是 DMA 的**边界**。
+   *
+   *   不写的话 DMA 不知道在第几行收手，会一直写到缓冲外面去 ——
+   *   而缓冲是 kmm 分配的，越界就是把堆的空闲链表写烂。
+   *
+   *   裁剪起点取 (0,0)，即整帧不裁；但 CROP_EN 仍要置位，厂商在
+   *   RK3576 上是无条件开的，尺寸寄存器要靠它生效。
+   */
+
+  cif_putreg(off + CIF_MIPI_ID0_CROP_START, 0);
+  cif_putreg(off + CIF_MIPI_SET_SIZE_ID0,
+             (uint32_t)width | ((uint32_t)height << 16));
+
   /* 5) 错误中断使能。不挂 ISR、靠轮询读 INTSTAT，但使能位必须打开，
    *    否则状态位不会置起来，读到的永远是 0，会被当成"没有错误"。
    */
@@ -246,7 +280,7 @@ int rk3576_cif_start(int host, uintptr_t buf0, uintptr_t buf1,
    *    而 id0 的格式还没配好，头几帧会按错误格式落盘。
    */
 
-  ctrl0 = CIF_ID_CAP_EN | CIF_ID_DMA_EN | CIF_ID_ALIGN_HIGH |
+  ctrl0 = CIF_ID_CAP_EN | CIF_ID_DMA_EN | CIF_ID_CROP_EN | CIF_ID_ALIGN_HIGH |
           ((uint32_t)CIF_ID_PARSE_RAW12     << CIF_ID_PARSE_SHIFT) |
           ((uint32_t)CIF_ID_WRDDR_UNCOMPACT << CIF_ID_WRDDR_SHIFT);
 
