-    .port = 8, .base = RK3576_I2C8_ADDR,
-    .gate_con = 13, .gate_pclk = 7, .gate_clk = 3,
-    .sel_con = 57, .sel_shift = 14,
-    .scl_bank = 2, .scl_pin = 14, .sda_bank = 2, .sda_pin = 15,
