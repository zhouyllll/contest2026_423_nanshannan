@@ -251,6 +307,81 @@ int rk3576_cif_start(int host, uintptr_t buf0, uintptr_t buf1,
   rk3576_clk_gate(CIF_BUS_GATE_CON, CIF_BUS_GATE_HCLK, true);
   rk3576_clk_gate(CIF_ICLK_GATE_CON, CIF_ICLK_GATE_BIT(host), true);
 
