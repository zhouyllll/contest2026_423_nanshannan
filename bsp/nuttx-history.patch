-#ifndef __ARCH_ARM64_SRC_RK3576_RK3576_GMAC_H
-#define __ARCH_ARM64_SRC_RK3576_RK3576_GMAC_H
-
-#include <nuttx/config.h>
-#include <stdbool.h>
-#include <stdint.h>
