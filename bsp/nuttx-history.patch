-/* ★ 本文件是 Synopsys DWMAC 4.x 的寄存器描述，取自
- *   arch/arm/src/s32k3xx/hardware/s32k3xx_emac.h。
- *
- *   RK3576 的 GMAC 与 S32K3XX 的 EMAC 是同一套 IP：MAC_CONFIGURATION
- *   0x0000、MAC_VERSION 0x0110、MAC_MDIO_ADDRESS 0x0200、MTL 0x0c00、
- *   DMA_MODE 0x1000、DMA_CH0 0x1100 —— 逐个核对过，偏移完全一致，
- *   板上读到的 MAC_VERSION 是 0x3051（snpsver 5.10a）。
- *
- *   基址由 Kconfig 选定：本驱动一次服务一个端口。
- *     GMAC0 = 0x2a220000（eth0）
- *     GMAC1 = 0x2a230000（eth1）
- */
-
-#ifdef CONFIG_RK3576_ETH_PORT1
-#  define RK3576_EMAC_BASE   RK3576_GMAC1_ADDR
-#else
-#  define RK3576_EMAC_BASE   RK3576_GMAC0_ADDR
-#endif
