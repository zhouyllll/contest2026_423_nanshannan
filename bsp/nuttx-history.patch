-#define GMAC_CLK_DIV1_125M    0u    /* 1000Mbps */
-#define GMAC_CLK_DIV5_25M     1u    /*  100Mbps */
-#define GMAC_CLK_DIV50_2_5M   2u    /*   10Mbps */
