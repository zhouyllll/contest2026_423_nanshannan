From f7143c782d15338d9bfb96a20594b259849fdf51 Mon Sep 17 00:00:00 2001
From: zhouyllll <xuezhou28@gmail.com>
Date: Sun, 6 Sep 2026 00:13:45 +0800
Subject: [PATCH 44/49] arch/arm64/rk3576: read the PHY on the GMAC failure
 path; MDIO proves unreliable

The probe returned at the DMA soft-reset timeout and never reached the
MDIO PHY-ID read, so the single most informative datum was never
collected -- several rounds of guessing whether the PHY was alive could
have been settled in one boot.  MDC/MDIO are driven by the MAC and do
not depend on the PHY's RX clock, so that read works even when the reset
hangs.  A check belongs where it can still run; behind a failure path it
may as well not exist.

What it showed, once it ran, is that MDIO itself cannot be trusted:

  boot A:  ID1=0xffff  ID2=0x4411
  boot B:  ID1=0x7b74  ID2=0x4411   BMCR=0xffff  BMSR=0x7949

A PHY's identifier registers are constant.  Reading different values
across boots means the bus is returning noise, and BMCR=0xffff is not a
legal value either.  So "the PHY is alive" -- which the first version of
this check concluded from ID2 alone -- does not hold.  Deciding it from
"at least one register is not 0xffff" was too weak a test; the check now
reads BMCR/BMSR as well, whose fixed bit patterns and link-status bit
make a garbled bus obvious.

Next suspect is the MDIO clock divider.  The CR field is hard-coded to 4,
which on DWMAC 4.x selects csr_clk/102 for a 150-250MHz CSR clock, and
MDC must stay under 2.5MHz.  The CSR clock rate on this port has never
actually been established.

Also: PHY reset timing now follows the board's device tree (20ms hold,
100ms after release) rather than the datasheet minimum (10/30).  Vendors
raise these when the board needs it.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01R8x2gNA2B8dB1TSCrtBacm
---
 arch/arm64/src/rk3576/rk3576_gmac.c | 83 +++++++++++++++++++++++++++--
 1 file changed, 79 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/src/rk3576/rk3576_gmac.c b/arch/arm64/src/rk3576/rk3576_gmac.c
index 87850136..b63b8408 100644
--- a/arch/arm64/src/rk3576/rk3576_gmac.c
+++ b/arch/arm64/src/rk3576/rk3576_gmac.c
@@ -307,15 +307,23 @@ static int gmac_mdio_read(int port, uint8_t phyaddr, uint8_t regaddr,
 
 void rk3576_gmac_phy_reset(int bank, int pin, bool active_low)
 {
-  /* 拉住复位至少 10ms，释放后再等 30ms 让 PHY 起振并开始出时钟。
-   * RTL8211F 手册要求复位脉冲不短于 10ms、释放后 30ms 内不访问 MDIO。
+  /* 复位时序取自本板设备树，而不是手册的最小值。
+   *
+   *   rk3576-kickpi-ethernet-gmac0.dtsi:
+   *     snps,reset-delays-us = <0 20000 100000>;
+   *     // Reset time is 20ms, 100ms for rtl8211f
+   *
+   *   三个数分别是"拉低前等待 / 保持复位 / 释放后等待"。原来这里用的是
+   *   手册最小值 10ms/30ms —— 能过手册，但比板厂实测值短。厂商会把这类
+   *   值往上调，通常是因为板上真的需要（电源建立慢、晶振起振慢）。
+   *   **有板级实测值时用板级的，手册最小值只是下界。**
    */
 
   rk3576_gpio_setdir(bank, pin, true);
   rk3576_gpio_write(bank, pin, active_low ? false : true);
-  up_mdelay(10);
+  up_mdelay(20);
   rk3576_gpio_write(bank, pin, active_low ? true : false);
-  up_mdelay(30);
+  up_mdelay(100);
 }
 
 int rk3576_gmac_probe(int port)
@@ -587,6 +595,73 @@ int rk3576_gmac_probe(int port)
              gmac_getreg(port, RK3576_GMAC_MAC_CONFIG),
              gmac_getreg(port, RK3576_GMAC_MAC_HW_FEATURE0),
              gmac_getreg(port, RK3576_GMAC_DMA_CH0_STATUS));
+
+      /* ★ 超时了也要先读一次 PHY ID 再返回。
+       *
+       *   MDC/MDIO 由 MAC 自己驱动，**不依赖 PHY 送来的 RX 时钟** ——
+       *   所以即使 DMA 软复位卡住，这条链路仍然可用。而它恰好能把两种
+       *   完全不同的情况一句话分开：
+       *
+       *     读到合法厂商 ID  -> PHY 供电、复位、MDIO 都正常，
+       *                         问题只在 RGMII 的时钟/延时通路上
+       *     读回 0xffff      -> PHY 根本没应答，先查供电与复位，
+       *                         再谈时钟
+       *
+       *   原来的代码把 PHY ID 的读取放在软复位**之后**，于是软复位一超时
+       *   就直接返回，这条最有信息量的判据从来没被执行过 —— 排查了几轮
+       *   都在猜 PHY 死没死。**判据要放在它还能执行的位置上**，放在失败
+       *   路径之后等于没有。
+       */
+
+      {
+        uint16_t bmcr = 0xffff;
+        uint16_t bmsr = 0xffff;
+        int i;
+
+        gmac_mdio_read(port, GMAC_PHY_ADDR, 0, &bmcr);   /* BMCR  */
+        gmac_mdio_read(port, GMAC_PHY_ADDR, 1, &bmsr);   /* BMSR  */
+        gmac_mdio_read(port, GMAC_PHY_ADDR, 2, &id1);    /* PHYID1 */
+        gmac_mdio_read(port, GMAC_PHY_ADDR, 3, &id2);    /* PHYID2 */
+
+        /* ★ 判据不能只看"有没有 0xffff"。
+         *
+         *   上一版只要 ID1/ID2 有一个不是 0xffff 就断言"PHY 活着" ——
+         *   那太弱了：MDIO 没人应答时总线被上拉，读回 0xffff；但**一个
+         *   寄存器读到别的值也可能只是噪声或时序毛刺**。实测就出现过
+         *   ID1=0xffff 而 ID2=0x4411 这种自相矛盾的组合，据此下结论是
+         *   不负责任的。
+         *
+         *   加两条更硬的：BMCR(reg0) 与 BMSR(reg1)。它们有明确的保留位
+         *   和固定位模式，全 0xffff 或全 0 都说明总线没在工作；而
+         *   BMSR bit2 是链路状态，直接回答"对端接上没有"这个问题 ——
+         *   这正是当前最需要知道的。
+         */
+
+        syslog(LOG_ERR,
+               "GMAC%d: PHY BMCR=0x%04x BMSR=0x%04x ID1=0x%04x ID2=0x%04x\n",
+               port, bmcr, bmsr, id1, id2);
+        up_mdelay(3);
+
+        syslog(LOG_ERR,
+               "GMAC%d: 链路=%s 自协商=%s（BMSR bit2/bit5）\n", port,
+               (bmsr != 0xffff && (bmsr & (1u << 2))) ? "已建立" : "未建立",
+               (bmsr != 0xffff && (bmsr & (1u << 5))) ? "已完成" : "未完成");
+        up_mdelay(3);
+
+        /* 链路没起来时再多等一会儿重读几次 —— 1000Base-T 自协商可能要
+         * 数秒，一次读不到不代表永远读不到。
+         */
+
+        for (i = 0; i < 5 && (bmsr == 0xffff || !(bmsr & (1u << 2))); i++)
+          {
+            up_mdelay(1000);
+            gmac_mdio_read(port, GMAC_PHY_ADDR, 1, &bmsr);
+            syslog(LOG_ERR, "GMAC%d:  第 %d 秒 BMSR=0x%04x\n",
+                   port, i + 1, bmsr);
+            up_mdelay(3);
+          }
+      }
+
       return -ETIMEDOUT;
     }
 
