From 2bc491ca30ae118e8f626465fcf7a66801a6591a Mon Sep 17 00:00:00 2001
From: zhouyllll <xuezhou28@gmail.com>
Date: Sun, 6 Sep 2026 12:45:53 +0800
Subject: [PATCH 47/49] arch/arm64/rk3576: port the DWMAC 4.x driver; link and
 MAC-level RX now work

Add rk3576_eth.c, ported from arch/arm/src/s32k3xx/s32k3xx_emac.c -- the
same Synopsys DWMAC 4.x, with every register offset verified identical
(MAC_CONFIGURATION 0x0000, MAC_VERSION 0x0110, MAC_MDIO_ADDRESS 0x0200,
MTL 0x0c00, DMA_MODE 0x1000, DMA_CH0 0x1100).  Clocks, GRF, pinmux, RGMII
delay lines and the PHY vendor init stay in rk3576_gmac_probe(); this
driver only does MAC/DMA and netdev.

Defects found and fixed along the way:

  * NR_IRQS was 288, from a comment citing rk356x-base.dtsi -- RK3568's
    dtsi, not RK3576's.  The real maximum SPI here is 388, and the GMAC
    interrupts (SPI 293/301 -> IRQ 325/333) fell outside the range, so
    irq_attach() failed outright.  Now 448.  The UART IRQ constants in
    the same header came from the same wrong dtsi (SPI 116-120 instead
    of 76-80) and are corrected too; they had gone unnoticed because the
    console uses CONFIG_16550_UART0_IRQ from the defconfig instead.

  * Descriptor stride.  The reference runs on a Cortex-M7 with 32-byte
    cache lines, so DESC_PADSIZE was 32 and DSL(4) -- skip 4 words --
    gave a matching 32-byte stride.  On arm64 the line is 64 bytes, so
    DESC_PADSIZE became 64 while DSL stayed 4: software placed
    descriptors every 64 bytes, the DMA read them every 32.  Everything
    past descriptor 0 read as padding with OWN clear, so the very first
    frame raised RBU and suspended the RX DMA.  DSL is now derived from
    DESC_PADSIZE.  Confirmed on hardware: RBU is gone.

  * netdev_carrier_on/off were missing (the reference lacks them too).
    IFF_UP alone is not enough -- routing looks at IFF_RUNNING, which
    only netdev_carrier_on() sets, so every sendto returned ENETUNREACH,
    including a ping to the board's own address.

  * The chip never declared ARCH_HAVE_NET, so DEBUG_NET could not even
    be selected.

  * MAC_CONFIGURATION now clears PS for gigabit rather than setting it
    unconditionally, and the negotiated speed is also written to the GRF
    RGMII divider via rk3576_gmac_set_speed(); configuring only one of
    the two leaves the link up but the data path dead.

Measured: link 1000M full duplex, netdev registered, and MMC counters
show frames received at the MAC with zero CRC errors -- the RGMII data
path is good.  Still open: the DMA interrupt never reaches the CPU (RI
sets but NIS does not), so received frames are not yet processed.  The
GIC side is verified correct (nlines 512, enabled, targeted at CPU0).

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01R8x2gNA2B8dB1TSCrtBacm
---
 arch/arm64/include/rk3576/irq.h              |   48 +-
 arch/arm64/src/rk3576/Kconfig                |   55 +-
 arch/arm64/src/rk3576/Make.defs              |    4 +
 arch/arm64/src/rk3576/hardware/rk3576_emac.h | 3103 +++++++++++++++
 arch/arm64/src/rk3576/rk3576_eth.c           | 3674 ++++++++++++++++++
 arch/arm64/src/rk3576/rk3576_eth.h           |   52 +
 arch/arm64/src/rk3576/rk3576_gmac.c          |   96 +-
 arch/arm64/src/rk3576/rk3576_gmac.h          |   16 +
 8 files changed, 7034 insertions(+), 14 deletions(-)
 create mode 100644 arch/arm64/src/rk3576/hardware/rk3576_emac.h
 create mode 100644 arch/arm64/src/rk3576/rk3576_eth.c
 create mode 100644 arch/arm64/src/rk3576/rk3576_eth.h

diff --git a/arch/arm64/include/rk3576/irq.h b/arch/arm64/include/rk3576/irq.h
index e34a4549..524b4935 100644
--- a/arch/arm64/include/rk3576/irq.h
+++ b/arch/arm64/include/rk3576/irq.h
@@ -38,12 +38,19 @@
  *   16 - 31   PPI  私有外设中断（含 Generic Timer）
  *   32 - ...  SPI  共享外设中断  ← 外设中断号 = dtsi 里的 SPI 号 + 32
  *
- * NR_IRQS：主线 rk356x-base.dtsi + rk3576.dtsi 中出现的最大 SPI 号为 231，
- * 对应中断号 231 + 32 = 263。取 288（32 的整数倍）留余量。
- * 该值偏大只多占一点内存，偏小会让对应外设中断静默挂不上且不报错。
+ * NR_IRQS：rk3576.dtsi 中出现的最大 SPI 号是 388，对应中断号
+ * 388 + 32 = 420。取 448（32 的整数倍）留余量。
+ * 该值偏大只多占一点内存，偏小会让对应外设中断挂不上。
+ *
+ * ★ 这里原先写的是 288，依据是"最大 SPI 号为 231" —— 那个数来自
+ *   **RK3568** 的 rk356x-base.dtsi，不是 RK3576。实际影响到的是所有
+ *   SPI 号大于 255 的外设，其中就有 GMAC：
+ *       gmac0 macirq = GIC_SPI 293 -> IRQ 325
+ *       gmac1 macirq = GIC_SPI 301 -> IRQ 333
+ *   两个都落在 288 之外，irq_attach() 直接失败。
  */
 
-#define NR_IRQS                 288
+#define NR_IRQS                 448
 
 /* Software Generated Interrupts (SGI) */
 
@@ -91,12 +98,33 @@
 
 #define RK3576_IRQ_SPI(n)       ((n) + 32)
 
-/* UART（来源：rk356x-base.dtsi）*/
+/* UART。出处：厂商 SDK 的 kernel-6.1 rk3576.dtsi。
+ *
+ * ★ 这里原先写的是 SPI 116~120，标注「来源：rk356x-base.dtsi」——
+ *   那是 **RK3568** 的编号，整整差了 40。RK3576 的 UART0 是 SPI 76。
+ *
+ *   之所以一直没暴露：串口实际用的中断号来自 defconfig 的
+ *   CONFIG_16550_UART0_IRQ=108（= 76 + 32，是对的），这些常量没人引用。
+ *   同一份 RK3568 dtsi 还带来了 NR_IRQS=288 那个真缺陷 —— GMAC 的
+ *   中断号 325/333 落在范围外，irq_attach() 直接失败。
+ *
+ *   **凡是标注来源为 rk356x 的常量都要按 RK3576 的 dtsi 复核一遍。**
+ */
+
+#define RK3576_IRQ_UART0        RK3576_IRQ_SPI(76)    /* 108 ← 调试口 */
+#define RK3576_IRQ_UART1        RK3576_IRQ_SPI(77)    /* 109 */
+#define RK3576_IRQ_UART2        RK3576_IRQ_SPI(78)    /* 110 */
+#define RK3576_IRQ_UART3        RK3576_IRQ_SPI(79)    /* 111 */
+#define RK3576_IRQ_UART4        RK3576_IRQ_SPI(80)    /* 112 */
+#define RK3576_IRQ_UART5        RK3576_IRQ_SPI(81)    /* 113 */
+#define RK3576_IRQ_UART6        RK3576_IRQ_SPI(82)    /* 114 */
+#define RK3576_IRQ_UART7        RK3576_IRQ_SPI(83)    /* 115 */
+#define RK3576_IRQ_UART10       RK3576_IRQ_SPI(86)    /* 118 */
+#define RK3576_IRQ_UART11       RK3576_IRQ_SPI(87)    /* 119 */
+
+/* GMAC。出处同上：gmac0 macirq = SPI 293、gmac1 macirq = SPI 301。 */
 
-#define RK3576_IRQ_UART0        RK3576_IRQ_SPI(116)   /* 148 */
-#define RK3576_IRQ_UART1        RK3576_IRQ_SPI(117)   /* 149 */
-#define RK3576_IRQ_UART2        RK3576_IRQ_SPI(118)   /* 150 ← 调试口 */
-#define RK3576_IRQ_UART3        RK3576_IRQ_SPI(119)   /* 151 */
-#define RK3576_IRQ_UART4        RK3576_IRQ_SPI(120)   /* 152 */
+#define RK3576_IRQ_GMAC0        RK3576_IRQ_SPI(293)   /* 325 */
+#define RK3576_IRQ_GMAC1        RK3576_IRQ_SPI(301)   /* 333 */
 
 #endif /* __ARCH_ARM64_INCLUDE_RK3576_IRQ_H */
diff --git a/arch/arm64/src/rk3576/Kconfig b/arch/arm64/src/rk3576/Kconfig
index d79eadd2..b871f022 100644
--- a/arch/arm64/src/rk3576/Kconfig
+++ b/arch/arm64/src/rk3576/Kconfig
@@ -266,8 +266,59 @@ config RK3576_GMAC
 		  已核对 MACCR=0x0000、MTL=0x0C00、DMA=0x1000 三处标志性偏移
 		  与 4.20a 一致。
 
-		当前实现前置链路与 MDIO：读 IP 版本证明寄存器块活着，
-		读 PHY 厂商 ID 证明 MDIO 时序与板级连线正确。收发路径后续补。
+		本项负责硬件上电：时钟、GRF、引脚复用、RGMII 延时线，
+		以及 PHY（Maxio MAE0621A）的厂商初始化 —— 不做这一步
+		PHY 的模拟前端不工作，MDIO 却照常可读写，很有迷惑性。
+		收发由 RK3576_ETH 提供。
+
+config RK3576_ETH
+	bool "以太网收发（DWMAC 4.x 网络设备）"
+	default n
+	depends on RK3576_GMAC && NET
+	select ARCH_HAVE_PHY
+	select ARCH_HAVE_NET
+	---help---
+		把 GMAC 注册成 NuttX 的网络设备。移植自
+		arch/arm/src/s32k3xx/s32k3xx_emac.c —— 那是同一套 Synopsys
+		DWMAC 4.x，寄存器偏移逐个核对完全一致。
+
+		硬件上电由 RK3576_GMAC 的 rk3576_gmac_probe() 完成，
+		本驱动只做 MAC/DMA 与设备注册。
+
+if RK3576_ETH
+
+config RK3576_ETH_PORT1
+	bool "用 GMAC1（eth1，0x2a230000）而不是 GMAC0"
+	default n
+	---help---
+		本驱动一次服务一个端口。选中则用 GMAC1，否则用 GMAC0。
+
+config RK3576_ETH_PHY_MAE0621A
+	bool "PHY 是 Maxio MAE0621A"
+	default y
+	---help---
+		KICKPI-K7 板上两路 GMAC 用的都是 Maxio MAE0621A-Q2C
+		（PHY ID 0x7b744411）。它的链路状态在分页寄存器
+		0xa43/0x1a，不在标准寄存器里。
+
+config RK3576_ETH_NETHIFS
+	int "网络接口数"
+	default 1
+	range 1 1
+
+config RK3576_ETH_NTXBUFFERS
+	int "发送描述符个数"
+	default 8
+
+config RK3576_ETH_NRXBUFFERS
+	int "接收描述符个数"
+	default 8
+
+config RK3576_ETH_BUFSIZE
+	int "DMA 缓冲区大小"
+	default 1536
+
+endif # RK3576_ETH
 
 endmenu # Rockchip RK3576 Peripheral Selection
 
