From 6e0c6a95613c0db62da6fa926e806f3afcea195d Mon Sep 17 00:00:00 2001
From: zhouyllll <xuezhou28@gmail.com>
Date: Mon, 31 Aug 2026 15:06:41 +0800
Subject: [PATCH 02/34] arm64/rk3576: fix illegal eret by clearing U-Boot's
 leftover HCR_EL2.TGE
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

在 KICKPI-K7 上从 U-Boot 的 booti 进入后，NuttX 早期打印正常，但 EL2->EL1
的 eret 立即崩溃，被 U-Boot 的 EL2 向量捕获：

  - Ready to Boot Primary CPU
  - Boot from EL2
  Bad mode in "Synchronous Abort" handler, esr 0x3a000000
  * Reason: Exception from an Illegal execution state...

ESR 的 EC = 0xE，即 Illegal Execution State。

根因：Rockchip 的 U-Boot 2017.09 在 EL2 运行时置了 HCR_EL2.TGE=1。ARM 架构
规定 TGE=1 时禁止 eret 到 EL1（Illegal Exception Return）。而通用层的
arm64_boot_el2_init() 对 HCR_EL2 用的是 read-modify-write：

    reg = read_sysreg(hcr_el2);
    reg |= HCR_RW_BIT;
    write_sysreg(reg, hcr_el2);

只补 RW、不清任何位，把 bootloader 的残留状态原样带进了 eret。
（Linux 内核在同一位置是覆盖写 HCR_EL2，不保留 bootloader 状态。这不是
RK3576 独有的问题，任何在 EL2 置了 TGE 的 bootloader 都会触发。）

修复放在 arm64_el_init()，即 arm64_head.S 中 "Platform hook for highest EL"
的回调，在 switch_el 之前、最高 EL 上执行，正是清理 bootloader 残留的位置。
本改动不触碰 arch/arm64 公共代码。

定位手法：arm64_lowputc 不使用栈，可在启动任何阶段调用，据此在 EL 切换
路径上插无栈单字符打点，把范围从"启动失败"收敛到单条 eret 指令，再逐项
回读 CurrentEL / HCR_EL2.RW / SPSR_EL2.M 排除常规原因。必须用单字符——
该板串口丢字节严重，长字符串会被截断误导。详见交付仓 notes/DEBUG-CASES.md
案例 3。

同时修正两项板上实测值：

  * CONFIG_LOAD_BASE 0x42000000 -> 0x40400000
    厂商 U-Boot 的环境变量以明文存在 eMMC uboot 分区，读出
    kernel_addr_r=0x40400000，与 U-Boot 主线 rk3576_common.h 的
    0x42000000 不同，板厂改过。另经实测确认 Rockchip 的 U-Boot 不按
    Image header 的 text_offset 重定位，就在 mmc read 的落点原地执行。

  * CONFIG_RAMBANK1_SIZE 512MB -> 64MB
    bdinfo 显示 DRAM 分两段，中间 0x48400000..0x49400000 的 16MB 是
    OP-TEE(BL32) 安全保留区，映射并访问会被 TZC 拦截。

并补入板上实测的外设基址：GMAC0/1、eMMC/SD/UFS、PCIe、DWC3、DP。

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FBQkQQFX3kTDP3AzvLzDGx
Signed-off-by: zhouyllll <xuezhou28@gmail.com>
---
 arch/arm64/include/rk3576/chip.h              | 36 ++++++++++---
 .../src/rk3576/hardware/rk3576_memorymap.h    | 34 ++++++++++++
 arch/arm64/src/rk3576/rk3576_boot.c           | 53 +++++++++++++++++--
 3 files changed, 111 insertions(+), 12 deletions(-)

diff --git a/arch/arm64/include/rk3576/chip.h b/arch/arm64/include/rk3576/chip.h
index c7c52b7a..3a4ab88d 100644
--- a/arch/arm64/include/rk3576/chip.h
+++ b/arch/arm64/include/rk3576/chip.h
@@ -113,8 +113,17 @@
  * 物理地址。
  */
 
-#define CONFIG_RAMBANK1_ADDR      0x42000000
-#define CONFIG_RAMBANK1_SIZE      MB(512)
+#define CONFIG_RAMBANK1_ADDR      0x40400000
+#define CONFIG_RAMBANK1_SIZE      MB(64)
+
+/* ⚠️ 不要把 RAMBANK1_SIZE 放大到跨过 0x48400000。
+ * 板上 bdinfo 显示 DRAM 分两段：
+ *   bank0  0x40200000 .. 0x48400000  (130 MB)
+ *   bank1  0x49400000 .. 0x100000000
+ * 中间 0x48400000..0x49400000 这 16MB 是 OP-TEE(BL32) 的安全保留区，
+ * 不属于任何 bank，映射并访问会被 TZC 拦截。
+ * 当前 0x40680000 + 64MB = 0x44680000，稳落在 bank0 内。
+ */
 
 /* 外设寄存器区。RK3576 的外设都在低位地址段：
  *
@@ -137,12 +146,23 @@
 
 /* U-Boot loads NuttX at this address (kernel_addr_r)
  *
- * 来源：U-Boot 主线 include/configs/rk3576_common.h（Rockchip 官方提交）
- *   ENV_MEM_LAYOUT_SETTINGS 中 "kernel_addr_r=0x42000000"
+ * ★★ 已由 KICKPI-K7 板上实测确认（2026-08-31）。
+ *
+ * 出厂 U-Boot 的环境变量以明文存在 eMMC 的 uboot 分区（mmcblk2p2）中，
+ * 在板上 Android 的 root shell 里读出：
+ *
+ *   $ strings /dev/block/mmcblk2p2 | grep -iE "addr_r|scriptaddr"
+ *     scriptaddr=0x40500000
+ *     kernel_addr_r=0x40400000      <- 本值
+ *     fdt_addr_r=0x48300000
+ *     ramdisk_addr_r=0x4a200000
+ *
+ * ★ 注意：这与 U-Boot 主线 include/configs/rk3576_common.h 里的
+ *   kernel_addr_r=0x42000000 不同 —— 板厂改过。先前按主线推断的
+ *   0x42000000 是错的，照它刷进去会是「完全没有输出且没有任何报错」，
+ *   因为 U-Boot 把镜像放在 0x40400000 而代码按 0x42000000 链接。
  *
- * ★ 注意这与 RK3568 的 0x02000000、RK3399 的 0x02080000 都不同，
- *   不要照抄。板厂可能改过这个环境变量，上板后用
- *   printenv kernel_addr_r 复核一次（RECON B3）。
+ *   同样与 RK3568 的 0x02000000、RK3399 的 0x02080000 都不同。
  *
  * 本值必须与三处保持一致，改一处就要改三处：
  *   1. 这里的 CONFIG_LOAD_BASE
@@ -152,7 +172,7 @@
  *      的第一行 ". ="
  */
 
-#define CONFIG_LOAD_BASE          0x42000000
+#define CONFIG_LOAD_BASE          0x40400000
 
 #define MPID_TO_CLUSTER_ID(mpid)  ((mpid) & ~0xff)
 
diff --git a/arch/arm64/src/rk3576/hardware/rk3576_memorymap.h b/arch/arm64/src/rk3576/hardware/rk3576_memorymap.h
index 1537411c..b8100980 100644
--- a/arch/arm64/src/rk3576/hardware/rk3576_memorymap.h
+++ b/arch/arm64/src/rk3576/hardware/rk3576_memorymap.h
@@ -107,6 +107,40 @@
 #define RK3576_I2C8_ADDR       0x2acb0000
 #define RK3576_I2C9_ADDR       0x2ae80000
 
+/* 存储控制器（供 M4 存储适配）
+ *
+ * 已由板上运行的出厂 Android 确认，其 bootargs 中：
+ *   androidboot.boot_devices=2a2d0000.ufs,2a330000.mmc,2a310000.mmc
+ * 与主线 dtsi 的节点一一对应。
+ *
+ *   sdhci : eMMC，8 位总线，HS400 1.8V + enhanced strobe，non-removable
+ *   sdmmc : SD 卡，4 位总线
+ */
+
+#define RK3576_UFSHC_ADDR      0x2a2d0000   /* UFS 主控 */
+#define RK3576_SDHCI_ADDR      0x2a330000   /* eMMC */
+#define RK3576_SDMMC_ADDR      0x2a310000   /* SD 卡 */
+
+/* 以太网（供 M5 网络适配）
+ *
+ * 已由板上运行的出厂 Android 内核日志确认：
+ *   rk_gmac-dwmac 2a220000.ethernet eth0: PHY [stmmac-0:00] driver [MAE0621A-Q2C Gigabit Ethernet]
+ *   rk_gmac-dwmac 2a230000.ethernet eth1: PHY [stmmac-1:00] driver [MAE0621A-Q2C Gigabit Ethernet]
+ *   dwmac4: Master AXI performs any burst length
+ *
+ * 控制器为 Synopsys DesignWare MAC 4.x（stmmac），PHY 是 MAXIO MAE0621A，
+ * rgmii-rxid 模式。PHY 复位脚见 board.h 的 BOARD_GMAC0/1_RST_*。
+ */
+
+#define RK3576_GMAC0_ADDR      0x2a220000   /* eth0 */
+#define RK3576_GMAC1_ADDR      0x2a230000   /* eth1 */
+
+/* 其它已确认的外设（暂未适配，记录备查） */
+
+#define RK3576_PCIE_ADDR       0x2a200000   /* rk-pcie */
+#define RK3576_USB_DWC3_ADDR   0x23000000   /* dwc3 */
+#define RK3576_DP_ADDR         0x27e40000   /* DisplayPort */
+
 /* PMU / SRAM */
 
 #define RK3576_PMU_ADDR        0x27380000
diff --git a/arch/arm64/src/rk3576/rk3576_boot.c b/arch/arm64/src/rk3576/rk3576_boot.c
index 559489f6..d2fb5605 100644
--- a/arch/arm64/src/rk3576/rk3576_boot.c
+++ b/arch/arm64/src/rk3576/rk3576_boot.c
@@ -47,6 +47,18 @@
 #include "rk3576_boot.h"
 #include "rk3576_serial.h"
 
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+/* HCR_EL2.TGE (Trap General Exceptions), bit[27]
+ *
+ * arch/arm64 通用层的 arm64_arch.h 只定义了 FMO/IMO/AMO/RW/ATA 几个位，
+ * 没有 TGE。这里在 SoC 层补一个本地定义，避免改动公共头文件。
+ */
+
+#define HCR_TGE_BIT                 BIT(27)
+
 /****************************************************************************
  * Private Data
  ****************************************************************************/
@@ -94,11 +106,44 @@ const struct arm_mmu_config g_mmu_config =
 
 void arm64_el_init(void)
 {
-  /* RK3576 的基础时钟由启动链路上游（TPL/SPL/U-Boot）配置完毕，
-   * M1 阶段这里不需要做任何事。
+  /* ★ 清除 U-Boot 遗留的 HCR_EL2.TGE。
+   *
+   * 现象：从 U-Boot 的 booti 进入后，汇编启动到 EL2->EL1 的 eret 就崩，
+   *       U-Boot 的 EL2 向量报 esr 0x3a000000（EC=0xE，Illegal Execution
+   *       State），且早期打印能正常输出到 "- Boot from EL2"。
    *
-   * 与 RK3399 端口保持一致（其 arm64_el_init 同样为空）。
-   * 后续若某个外设需要在极早期就改时钟，再在这里补 CRU 操作。
+   * 根因：Rockchip 的 U-Boot 2017.09 在 EL2 运行时置了 HCR_EL2.TGE=1。
+   *       ARM 架构规定 TGE=1 时禁止 eret 到 EL1（Illegal Exception Return）。
+   *       而 arch/arm64 通用层的 arm64_boot_el2_init() 对 HCR_EL2 用的是
+   *       read-modify-write：
+   *
+   *           reg = read_sysreg(hcr_el2);
+   *           reg |= HCR_RW_BIT;
+   *           write_sysreg(reg, hcr_el2);
+   *
+   *       只补 RW、不清任何位，于是把 bootloader 的残留状态带进了 eret。
+   *       （Linux 内核在同一位置是覆盖写 HCR_EL2，不保留 bootloader 状态。）
+   *
+   * 定位：在 arm64_head.S 的 EL 切换路径上插无栈单字符打点，输出为
+   *       "12E2- Boot from EL2 abcd2RT*4>e- Boot from EL1 fgh...i"，
+   *       其中 T 表示读到 TGE=1，* 之后 eret 立即成功。
+   *
+   * 本函数是 arm64_head.S 里 "Platform hook for highest EL" 的回调，
+   * 在 switch_el 之前、最高 EL 上执行，正是清理 bootloader 残留的位置。
+   */
+
+  uint64_t reg;
+
+  if (arm64_current_el() == MODE_EL2)
+    {
+      reg = read_sysreg(hcr_el2);
+      reg &= ~HCR_TGE_BIT;
+      write_sysreg(reg, hcr_el2);
+      UP_ISB();
+    }
+
+  /* RK3576 的基础时钟由启动链路上游（TPL/SPL/U-Boot）配置完毕，
+   * M1 阶段无需在此操作 CRU。
    */
 }
 
