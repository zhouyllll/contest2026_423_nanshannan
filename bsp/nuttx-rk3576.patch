 arch/arm64/src/rk3576/Make.defs               |   4 +
 .../src/rk3576/hardware/rk3576_memorymap.h    |   9 +
 arch/arm64/src/rk3576/hardware/rk3576_vop2.h  | 107 +++++++++
 arch/arm64/src/rk3576/rk3576_vop2.c           | 224 ++++++++++++++++++
 arch/arm64/src/rk3576/rk3576_vop2.h           |  81 +++++++
 6 files changed, 440 insertions(+)
 create mode 100644 arch/arm64/src/rk3576/hardware/rk3576_vop2.h
