Subject: [PATCH 10/34] =?UTF-8?q?arm64/rk3576:=20eMMC=20=E5=9D=97=E8=AE=BE?=
 =?UTF-8?q?=E5=A4=87=E8=AF=BB=E9=80=9A=EF=BC=881=20=E4=BD=8D=20@50MHz?=
 =?UTF-8?q?=EF=BC=89=EF=BC=8C4=20=E4=BD=8D=E5=BE=85=E4=BF=AE?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

板上实测：
  SDHCI: 卡时钟 52000000Hz (div=2 实际约 50000000Hz) HS=1
  nsh> hexdump /dev/mmcsd0c count=512
  0000: 00 00 ...                    （GPT 保护性 MBR 引导区）
  01f0: ... 55 aa                    （MBR 签名，数据正确）

本次修复
--------
1. 25MHz 以上必须置 HOSTCTRL1 的 High Speed 位
   规范要求：清零时控制器按低速时序采样，高频会采错。
   命令线速率低、余量大，先坏的总是数据线 —— 因此表现为"卡能识别、
   CID/CSD 能读、块设备能注册，唯独读数据超时"。

2. R1b 命令要等忙状态解除
   R1b 无数据相位但用 DAT0 表示卡忙。原先 sendcmd 只在 xfer_armed 时
   等 DATINHIBIT，会漏掉 R1b；waitresponse 也只等 CMDCOMPLETE。
   于是可能在卡仍忙时下发下一条命令，打断尚未完成的操作。
   现在两处都按规范处理（DATINHIBIT + XFERCOMPLETE）。

3. BCH 注册 /dev/mmcsd0c
   NuttX 块设备不能直接 open()，dd/hexdump 走字符设备接口。
   只读注册，避免误写坏 eMMC 上原有分区。

★ 已知限制：4 位总线不可用，当前声明 SDIO_CAPS_1BIT_ONLY
------------------------------------------------------
定位过程（三次单变量实验逐个排除）：
  1 位 + 1MHz    读通，MBR 签名正确
  4 位 + 1MHz    超时  → 与时钟频率无关，排除全部时序假设
  4 位 + 50MHz   超时
超时时刻的控制器状态：BLKSIZE/xfer 配置全对、命令完成、
PRESENT 显示读传输进行中，但 BUFRDRDY 始终不置位、缓冲区无数据。

两个待验证的方向，都有硬判据、无需推测：
  a) 卡实际没切到 4 位 —— 切换后读回 EXT_CSD 的 BUS_WIDTH(183) 即可确认
  b) 主机侧位宽字段位置不对 —— 对照 Linux sdhci-of-dwcmshc.c 核对

1 位 @50MHz 约 6MB/s，先作为可用配置交付。

过程记录：本次曾两度把"找到一个真实缺陷"误当成"找到本次故障的根因"
（High Speed 位、R1b 忙等）。两者的区别在于修复后现象是否按预期方向
改变 —— 行为有变化不等于接近了答案。
---
 arch/arm64/src/rk3576/rk3576_sdhci.c | 101 ++++++++++++++++++++++++---
 1 file changed, 93 insertions(+), 8 deletions(-)

diff --git a/arch/arm64/src/rk3576/rk3576_sdhci.c b/arch/arm64/src/rk3576/rk3576_sdhci.c
index a3b84e47..a2996f1a 100644
--- a/arch/arm64/src/rk3576/rk3576_sdhci.c
+++ b/arch/arm64/src/rk3576/rk3576_sdhci.c
@@ -143,6 +143,29 @@ static int sdhci_setclock(uint32_t freq_hz)
   uint32_t div;
   int us;
 
+  /* ★ 超过 25MHz 必须置 HOSTCTRL1 的 High Speed 位。
+   *
+   *   SDHCI 规范：High Speed 清零时控制器按"数据在 SDCLK 上升沿之后
+   *   保持"的低速时序采样，25MHz 以上会采错。置位后改用高速时序。
+   *
+   *   漏掉它的表现是命令全部正常、数据相位静默超时 —— 因为命令线
+   *   速率低、时序余量大，先坏的总是数据线。本端口实测：400kHz 下
+   *   自写的探测能正确读出块0 的 MBR 签名，一旦上层把时钟提到 50MHz
+   *   就 SDIOWAIT_TIMEOUT。
+   */
+
+  regval = sdhci_getreg(RK3576_SDHCI_HOSTCTRL1);
+  if (freq_hz > 25000000)
+    {
+      regval |= SDHCI_HOSTCTRL1_HISPEED;
+    }
+  else
+    {
+      regval &= ~SDHCI_HOSTCTRL1_HISPEED;
+    }
+
+  sdhci_putreg(RK3576_SDHCI_HOSTCTRL1, regval);
+
   /* 关掉卡时钟再动分频 */
 
   regval = sdhci_getreg(RK3576_SDHCI_CLKCTRL);
@@ -188,9 +211,11 @@ static int sdhci_setclock(uint32_t freq_hz)
   sdhci_putreg(RK3576_SDHCI_CLKCTRL, regval | SDHCI_CLK_SDCLKEN);
 
   syslog(LOG_INFO, "SDHCI: 卡时钟 %" PRIu32 "Hz (div=%" PRIu32
-                   " 实际约 %" PRIu32 "Hz)\n",
+                   " 实际约 %" PRIu32 "Hz) HS=%d\n",
          freq_hz, div,
-         div ? RK3576_SDHCI_BASECLK_HZ / (2 * div) : RK3576_SDHCI_BASECLK_HZ);
+         div ? RK3576_SDHCI_BASECLK_HZ / (2 * div) : RK3576_SDHCI_BASECLK_HZ,
+         (sdhci_getreg(RK3576_SDHCI_HOSTCTRL1) &
+          SDHCI_HOSTCTRL1_HISPEED) ? 1 : 0);
   return OK;
 }
 
@@ -444,11 +469,23 @@ static sdio_capset_t rk3576_sdio_capabilities(struct sdio_dev_s *dev)
 {
   UNUSED(dev);
 
-  /* 只声明确实实现了的能力。CAP0 里虽然有 8 位总线和 ADMA2，
-   * 但驱动当前是 PIO，声明 DMA 会让上层走没实现的路径。
+  /* ★ 单变量实验：声明只支持 1 位总线。
+   *
+   *   自写探测在 1 位下能正确读出块0；上层接管后 mmcsd 把卡和主机
+   *   都切到了 4 位，此后数据相位永远等不到 BUFRDRDY。降到 1MHz 也
+   *   照样失败，已排除时序因素，剩下的差异就是总线宽度。
+   *
+   *   返回 SDIO_CAPS_1BIT_ONLY 会让 mmcsd 跳过 CMD6 的宽总线切换：
+   *     1 位能读通 → 确认问题出在 4 位数据路径
+   *     1 位仍失败 → 与总线宽度无关，回头查 eventwait 与控制器交互
+   *
+   *   确认后再决定 4 位怎么修，本行不是最终形态。
+   *
+   *   另：CAP0 里虽然有 ADMA2，但本驱动是 PIO，不声明 DMASUPPORTED，
+   *   否则上层会走没实现的 dmarecvsetup 路径。
    */
 
-  return 0;
+  return SDIO_CAPS_1BIT_ONLY;
 }
 
 static sdio_statset_t rk3576_sdio_status(struct sdio_dev_s *dev)
@@ -501,8 +538,8 @@ static void rk3576_sdio_clock(struct sdio_dev_s *dev, enum sdio_clock_e rate)
         break;
 
       default:
-        /* MMC/SD 传输模式。先取 High Speed 的 52MHz —— HS200/HS400 需要
-         * DLL 采样窗口整定，留到后面做。
+        /* MMC 传输模式，52MHz High Speed。
+         * HS200/HS400 需要 DLL 采样窗口整定，后续再做。
          */
 
         sdhci_setclock(52000000);
@@ -539,7 +576,17 @@ static int rk3576_sdio_sendcmd(struct sdio_dev_s *dev, uint32_t cmd,
     {
       uint32_t busy = SDHCI_PRESENT_CMDINHIBIT;
 
-      if (priv->xfer_armed)
+      /* ★ 带数据的命令要等 DAT 线，R1b 同样要等 —— 它虽然没有数据相位，
+       * 却会用 DAT0 表示"卡忙"。只按 xfer_armed 判断会漏掉 R1b，
+       * 于是在卡还忙时就下发下一条命令。
+       *
+       * 这一点很隐蔽：mmcsd 用 CMD6 SWITCH(R1b) 切换卡的总线宽度，
+       * 如果没等它真正完成就继续，切换可能未生效 —— 主机按 4 位收、
+       * 卡仍按 1 位发，后续读数据永远等不到 BUFRDRDY。
+       */
+
+      if (priv->xfer_armed ||
+          (cmd & MMCSD_RESPONSE_MASK) == MMCSD_R1B_RESPONSE)
         {
           busy |= SDHCI_PRESENT_DATINHIBIT;
         }
@@ -604,6 +651,7 @@ static int rk3576_sdio_sendcmd(struct sdio_dev_s *dev, uint32_t cmd,
 
   sdhci_putreg(RK3576_SDHCI_INTSTAT, 0xffffffff);
   sdhci_putreg(RK3576_SDHCI_ARG, arg);
+
   sdhci_putreg(RK3576_SDHCI_XFERMODE,
                ((cmdidx << SDHCI_CMD_INDEX_SHIFT) | cmdreg) << 16 | xfer);
   return OK;
@@ -685,6 +733,32 @@ static int rk3576_sdio_waitresponse(struct sdio_dev_s *dev, uint32_t cmd)
       return ((status & SDHCI_INT_CMDTIMEOUT) != 0) ? -ETIMEDOUT : -EIO;
     }
 
+  /* ★ R1b：命令完成不等于事务完成。卡会拉低 DAT0 表示"正在处理"，
+   * 控制器在忙状态解除时给出 XFERCOMPLETE。不等它就继续下发命令，
+   * 会打断尚未生效的操作（典型如 CMD6 SWITCH 改总线宽度）。
+   */
+
+  if ((cmd & MMCSD_RESPONSE_MASK) == MMCSD_R1B_RESPONSE)
+    {
+      for (us = 0; us < SDHCI_CMD_TIMEOUT_US; us++)
+        {
+          status = sdhci_getreg(RK3576_SDHCI_INTSTAT);
+          if ((status & SDHCI_INT_XFERCOMPLETE) != 0)
+            {
+              sdhci_putreg(RK3576_SDHCI_INTSTAT, SDHCI_INT_XFERCOMPLETE);
+              break;
+            }
+
+          if ((status & SDHCI_INT_DATAERRORS) != 0)
+            {
+              sdhci_reset(SDHCI_RESET_DATA);
+              return -EIO;
+            }
+
+          up_udelay(1);
+        }
+    }
+
   return OK;
 }
 
@@ -796,6 +870,17 @@ static sdio_eventset_t rk3576_sdio_eventwait(struct sdio_dev_s *dev)
 
       if (us >= limit)
         {
+          syslog(LOG_ERR,
+                 "SDHCI 数据超时: INTSTAT=0x%08" PRIx32
+                 " PRESENT=0x%08" PRIx32 " BLKSIZE=0x%08" PRIx32
+                 " HC1=0x%08" PRIx32 " CLK=0x%08" PRIx32
+                 " 待传=%zu 写=%d\n",
+                 sdhci_getreg(RK3576_SDHCI_INTSTAT),
+                 sdhci_getreg(RK3576_SDHCI_PRESENT),
+                 sdhci_getreg(RK3576_SDHCI_BLKSIZE),
+                 sdhci_getreg(RK3576_SDHCI_HOSTCTRL1),
+                 sdhci_getreg(RK3576_SDHCI_CLKCTRL),
+                 priv->remaining, (int)priv->is_write);
           priv->xfer_armed = false;
           return SDIOWAIT_TIMEOUT;
         }
