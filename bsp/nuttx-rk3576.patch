diff --git a/arch/arm64/src/rk3576/Kconfig b/arch/arm64/src/rk3576/Kconfig
index 15b8c0cd..274b22e7 100644
--- a/arch/arm64/src/rk3576/Kconfig
+++ b/arch/arm64/src/rk3576/Kconfig
@@ -110,6 +110,21 @@ config RK3576_DCPHY
 		  的配置只能"回读一致"，证明不了对错；PLL 锁定与否由硬件决定。
 		  锁不上就不必往下查 VOP/DSI。
 
+config RK3576_GMAC
+	bool "以太网 GMAC"
+	default n
+	---help---
+		Synopsys DesignWare MAC 4.20a（stmmac 系）。两路：
+		GMAC0 0x2a220000、GMAC1 0x2a230000，同属电源域 PD_SDGMAC。
+
+		★ NuttX 里已有同 IP 家族的成熟实现可参照：
+		  arch/arm/src/stm32h7/stm32_ethernet.c（4267 行）。
+		  已核对 MACCR=0x0000、MTL=0x0C00、DMA=0x1000 三处标志性偏移
+		  与 4.20a 一致。
+
+		当前实现前置链路与 MDIO：读 IP 版本证明寄存器块活着，
+		读 PHY 厂商 ID 证明 MDIO 时序与板级连线正确。收发路径后续补。
+
 endmenu # Rockchip RK3576 Peripheral Selection
 
 endif # ARCH_CHIP_RK3576
