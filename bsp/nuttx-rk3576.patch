new file mode 100644
index 00000000..ec46e529
--- /dev/null
+++ b/arch/arm64/src/rk3576/hardware/rk3576_vop2.h
@@ -0,0 +1,107 @@
+/****************************************************************************
+ * arch/arm64/src/rk3576/hardware/rk3576_vop2.h
+ *
