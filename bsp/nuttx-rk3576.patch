 arch/arm64/src/rk3576/Make.defs              |   4 +
 arch/arm64/src/rk3576/hardware/rk3576_dsi2.h | 112 +++++++
 arch/arm64/src/rk3576/rk3576_dsi2.c          | 290 +++++++++++++++++++
 arch/arm64/src/rk3576/rk3576_dsi2.h          | 103 +++++++
 5 files changed, 524 insertions(+)
 create mode 100644 arch/arm64/src/rk3576/hardware/rk3576_dsi2.h
