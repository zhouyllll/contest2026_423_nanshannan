 arch/arm64/src/rk3576/rk3576_spi.h          |  68 ++
 5 files changed, 960 insertions(+)
 create mode 100644 arch/arm64/src/rk3576/hardware/rk3576_spi.h
 create mode 100644 arch/arm64/src/rk3576/rk3576_spi.c
