From 86a2c46526107c38f6f8ff54d86ea5ff8629c6f9 Mon Sep 17 00:00:00 2001
From: zhouyllll <xuezhou28@gmail.com>
Date: Fri, 4 Sep 2026 22:55:50 +0800
Subject: [PATCH 32/34] arch/arm64/rk3576: add CIF capture controller, log GPIO
 interrupt storms

CIF is the last stage of the camera path (sensor -> D-PHY -> CSI-2 host
-> CIF -> DDR).  It takes the CSI-2 stream into a caller-supplied
buffer, so a frame can be inspected in memory before anything is
displayed -- keeping "did we capture" separate from "did we render".

Also switch the GPIO interrupt-storm guard from gpioerr() to syslog().
gpioerr() compiles away unless GPIO debug is enabled, so the guard was
masking a pin without leaving any record: a loud failure quietly became
a silent one, which is strictly harder to diagnose.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01R8x2gNA2B8dB1TSCrtBacm
---
 arch/arm64/src/rk3576/Kconfig       |  14 ++
 arch/arm64/src/rk3576/Make.defs     |   4 +
 arch/arm64/src/rk3576/rk3576_cif.c  | 325 ++++++++++++++++++++++++++++
 arch/arm64/src/rk3576/rk3576_cif.h  |  62 ++++++
 arch/arm64/src/rk3576/rk3576_gpio.c |  16 +-
 5 files changed, 418 insertions(+), 3 deletions(-)
 create mode 100644 arch/arm64/src/rk3576/rk3576_cif.c
 create mode 100644 arch/arm64/src/rk3576/rk3576_cif.h

diff --git a/arch/arm64/src/rk3576/Kconfig b/arch/arm64/src/rk3576/Kconfig
index 034fbcbc..726e3a30 100644
--- a/arch/arm64/src/rk3576/Kconfig
+++ b/arch/arm64/src/rk3576/Kconfig
@@ -22,6 +22,20 @@ config RK3576_UART0_IS_CONSOLE
 		已由 KICKPI 官方 Armbian 源码的 U-Boot defconfig 确认：
 		CONFIG_DEBUG_UART_BASE=0x2ad40000，即 UART0。
 
+config RK3576_CIF
+	bool "VICAP/CIF 取图"
+	default n
+	select RK3576_CSIHOST
+	---help---
+		取图链路的最后一级：把 CSI-2 收到的像素写进 DDR。
+
+		五路 CSI 输入共用一套寄存器，按 csi_host_idx 加偏移区分，
+		而且前两路间距 0x200、之后是 0x100 —— 不是等差数列，
+		按等差算会写到隔壁那一路上，不报错。
+
+		输出用非压缩 RAW12（每像素 16 位）：显示时取高字节即灰度，
+		省掉位解包一环。
+
 config RK3576_CSIHOST
 	bool "MIPI CSI-2 主机控制器"
 	default n
