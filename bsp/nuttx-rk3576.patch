From 84d0c755aa873b306fefd87a20e4c2e0abccf064 Mon Sep 17 00:00:00 2001
From: zhouyllll <xuezhou28@gmail.com>
Date: Tue, 1 Sep 2026 14:14:24 +0800
Subject: [PATCH 11/15] =?UTF-8?q?arm64/rk3576:=20eMMC=204=20=E4=BD=8D?=
 =?UTF-8?q?=E6=80=BB=E7=BA=BF=E6=89=93=E9=80=9A=EF=BC=8850MHz=EF=BC=89?=
 =?UTF-8?q?=EF=BC=8C=E6=A0=B9=E5=9B=A0=E6=98=AF=E8=83=BD=E5=8A=9B=E5=A3=B0?=
 =?UTF-8?q?=E6=98=8E?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

板上实测：
  SDHCI: 卡时钟 52000000Hz (div=2 实际约 50000000Hz) HS=1
  nsh> hexdump /dev/mmcsd0c count=512
  01f0: ... 55 aa        MBR 签名正确

根因：capabilities() 返回 0，导致卡与主机位宽不一致
------------------------------------------------
drivers/mmcsd/mmcsd_sdio.c 的 mmcsd_widebus() 里，两处判断条件不同：

  用 CMD6 把【卡】切到 4 位   要求 priv->buswidth 带 4BIT 标志
  用 SDIO_WIDEBUS 设【主机】  只要求 IS_MMC()

而对 MMC 卡，priv->buswidth 的 4BIT 标志只在
(caps & SDIO_CAPS_4BIT_ONLY) 成立时才被置上（约 3938 行）。

于是 capabilities() 返回 0 时：CMD6 被跳过、卡仍是 1 位，而主机被设成
4 位。命令线照常工作（命令走 CMD 线，与数据位宽无关），唯独数据相位
永远等不到 BUFRDRDY。改为返回 SDIO_CAPS_4BIT_ONLY 后即通。

定位过程
--------
三次单变量实验把范围逐层收敛，每次只改一个条件：
  1 位 + 1MHz    读通    → 基准
  4 位 + 1MHz    超时    → 与时钟频率无关，排除全部时序假设
                            （High Speed 位、DLL 整定、PHY 参数）
  4 位 + 50MHz   超时
超时时刻的寄存器：BLKSIZE/xfer 配置全对、CMDCOMPLETE 已置、
PRESENT 显示读传输进行中、BUFRDRDY 始终为 0。
最后读 mmcsd_sdio.c 的上层逻辑找到条件不一致，而非继续试参数。

★ 过程中两次误判，都记录在案
  把 High Speed 位、R1b 忙等分别当成过本次故障的根因。两者都是真实
  缺陷、按规范该修，但都不是本次的原因。判别方法：修复后现象是否按
  预期方向改变 —— "行为有变化"不等于"接近了答案"。

上游线索（待验证后再决定是否提 PR）
  mmcsd_widebus() 的这处条件不对称，对同时支持 1 位与 4 位的 host
  （绝大多数 SDHCI）意味着：对 MMC 卡永远不发 CMD6，却会把主机设成
  4 位。只有声明"只支持 4 位"才能得到一致配置，语义是拧的。
  提交前需先确认这不是本端口的用法问题。
---
 arch/arm64/src/rk3576/rk3576_sdhci.c | 25 ++++++++++++++-----------
 1 file changed, 14 insertions(+), 11 deletions(-)

diff --git a/arch/arm64/src/rk3576/rk3576_sdhci.c b/arch/arm64/src/rk3576/rk3576_sdhci.c
index a2996f1a..2206c8ab 100644
--- a/arch/arm64/src/rk3576/rk3576_sdhci.c
+++ b/arch/arm64/src/rk3576/rk3576_sdhci.c
@@ -469,23 +469,26 @@ static sdio_capset_t rk3576_sdio_capabilities(struct sdio_dev_s *dev)
 {
   UNUSED(dev);
 
-  /* ★ 单变量实验：声明只支持 1 位总线。
+  /* ★ 必须声明 SDIO_CAPS_4BIT_ONLY，否则卡和主机的位宽会不一致。
    *
-   *   自写探测在 1 位下能正确读出块0；上层接管后 mmcsd 把卡和主机
-   *   都切到了 4 位，此后数据相位永远等不到 BUFRDRDY。降到 1MHz 也
-   *   照样失败，已排除时序因素，剩下的差异就是总线宽度。
+   *   drivers/mmcsd/mmcsd_sdio.c 里两处判断条件不同：
    *
-   *   返回 SDIO_CAPS_1BIT_ONLY 会让 mmcsd 跳过 CMD6 的宽总线切换：
-   *     1 位能读通 → 确认问题出在 4 位数据路径
-   *     1 位仍失败 → 与总线宽度无关，回头查 eventwait 与控制器交互
+   *     用 CMD6 把【卡】切到 4 位 —— 要求 priv->buswidth 带 4BIT 标志
+   *     用 SDIO_WIDEBUS 把【主机】设成 4 位 —— 只要求 IS_MMC()
    *
-   *   确认后再决定 4 位怎么修，本行不是最终形态。
+   *   而对 MMC 卡，priv->buswidth 的 4BIT 标志只在
+   *   (caps & SDIO_CAPS_4BIT_ONLY) 成立时才被置上（mmcsd_sdio.c 约 3938 行）。
    *
-   *   另：CAP0 里虽然有 ADMA2，但本驱动是 PIO，不声明 DMASUPPORTED，
-   *   否则上层会走没实现的 dmarecvsetup 路径。
+   *   所以 capabilities() 返回 0 时：CMD6 被跳过、卡仍是 1 位，
+   *   而主机被设成 4 位 —— 命令线照常工作（命令走 CMD 线，与位宽无关），
+   *   唯独数据相位永远等不到 BUFRDRDY。本端口实测就是这个现象，
+   *   且降到 1MHz 也不改善，因为它根本不是时序问题。
+   *
+   *   不声明 DMASUPPORTED：CAP0 里有 ADMA2，但本驱动是 PIO，
+   *   声明了会让上层走没实现的 dmarecvsetup 路径。
    */
 
-  return SDIO_CAPS_1BIT_ONLY;
+  return SDIO_CAPS_4BIT_ONLY;
 }
 
 static sdio_statset_t rk3576_sdio_status(struct sdio_dev_s *dev)
