 arch/arm64/src/rk3576/hardware/rk3576_sai.h   | 126 +++++
 arch/arm64/src/rk3576/rk3576_sai.c            | 432 ++++++++++++++++++
 arch/arm64/src/rk3576/rk3576_sai.h            |  63 +++
 6 files changed, 645 insertions(+)
