 create mode 100644 arch/arm64/src/rk3576/rk3576_sai.c
 create mode 100644 arch/arm64/src/rk3576/rk3576_sai.h

diff --git a/arch/arm64/src/rk3576/Kconfig b/arch/arm64/src/rk3576/Kconfig
index ccc5574c..dbaa1315 100644
--- a/arch/arm64/src/rk3576/Kconfig
+++ b/arch/arm64/src/rk3576/Kconfig
@@ -53,6 +53,19 @@ config RK3576_SDHCI
 		字段为 200MHz，与 dtsi 的 assigned-clock-rates 一致，说明
 		PD_NVM 电源域与五路时钟都已就绪。
 
+config RK3576_SAI
+	bool "SAI 音频接口"
+	default n
+	---help---
+		RK3576 的音频接口是 SAI（Serial Audio Interface），不是传统
+		I2S，寄存器布局取自 Linux sound/soc/rockchip/rockchip_sai.c。
+
+		板上 ES8388 codec 接在 SAI1（0x2a610000），codec 驱动用上游
+		现成的 drivers/audio/es8388.c。
+
+		当前只实现 rk3576_sai_probe()：打开 PD_AUDIO 电源域与三路时钟、
+		配置引脚复用，读版本寄存器自检。i2s_dev_s 与传输逻辑后续补。
+
 endmenu # Rockchip RK3576 Peripheral Selection
 
 endif # ARCH_CHIP_RK3576
