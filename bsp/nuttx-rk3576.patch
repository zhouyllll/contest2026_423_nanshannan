 arch/arm64/src/rk3576/Make.defs               |   4 +
 .../src/rk3576/hardware/rk3576_memorymap.h    |   6 +
 arch/arm64/src/rk3576/rk3576_dcphy.c          | 276 ++++++++++++++++++
 arch/arm64/src/rk3576/rk3576_dcphy.h          |  62 ++++
 5 files changed, 362 insertions(+)
