+ * distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+ * WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.  See the
+ * License for the specific language governing permissions and limitations
+ * under the License.
+ *
+ ****************************************************************************/
+
+/* This file should never be included directly but, rather,
+ * only indirectly through nuttx/irq.h
+ */
+
+#ifndef __ARCH_ARM64_INCLUDE_RK3576_IRQ_H
+#define __ARCH_ARM64_INCLUDE_RK3576_IRQ_H
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+/* Rockchip RK3576 Interrupts
+ *
+ * GICv3 中断号布局（与 SoC 无关的固定部分）：
+ *   0  - 15   SGI  软件生成中断
+ *   16 - 31   PPI  私有外设中断（含 Generic Timer）
+ *   32 - ...  SPI  共享外设中断  ← 外设中断号 = dtsi 里的 SPI 号 + 32
+ *
+ * NR_IRQS：主线 rk356x-base.dtsi + rk3576.dtsi 中出现的最大 SPI 号为 231，
+ * 对应中断号 231 + 32 = 263。取 288（32 的整数倍）留余量。
+ * 该值偏大只多占一点内存，偏小会让对应外设中断静默挂不上且不报错。
+ */
+
+#define NR_IRQS                 288
+
+/* Software Generated Interrupts (SGI) */
+
+#define RK3576_IRQ_SGI0         (0)
+#define RK3576_IRQ_SGI1         (1)
+#define RK3576_IRQ_SGI2         (2)
+#define RK3576_IRQ_SGI3         (3)
+#define RK3576_IRQ_SGI4         (4)
+#define RK3576_IRQ_SGI5         (5)
+#define RK3576_IRQ_SGI6         (6)
+#define RK3576_IRQ_SGI7         (7)
+#define RK3576_IRQ_SGI8         (8)
+#define RK3576_IRQ_SGI9         (9)
+#define RK3576_IRQ_SGI10        (10)
+#define RK3576_IRQ_SGI11        (11)
+#define RK3576_IRQ_SGI12        (12)
+#define RK3576_IRQ_SGI13        (13)
+#define RK3576_IRQ_SGI14        (14)
+#define RK3576_IRQ_SGI15        (15)
+
+/* Private Peripheral Interrupts (PPI) */
+
+#define RK3576_IRQ_PPI0         (16)
+#define RK3576_IRQ_PPI1         (17)
+#define RK3576_IRQ_PPI2         (18)
+#define RK3576_IRQ_PPI3         (19)
+#define RK3576_IRQ_PPI4         (20)
+#define RK3576_IRQ_PPI5         (21)
+#define RK3576_IRQ_PPI6         (22)
+#define RK3576_IRQ_PPI7         (23)
+#define RK3576_IRQ_PPI8         (24)
+#define RK3576_IRQ_PPI9         (25)
+#define RK3576_IRQ_PPI10        (26)
+#define RK3576_IRQ_PPI11        (27)
+#define RK3576_IRQ_PPI12        (28)
+#define RK3576_IRQ_PPI13        (29)
+#define RK3576_IRQ_PPI14        (30)
+#define RK3576_IRQ_PPI15        (31)
+
+/* Shared Peripheral Interrupts (SPI)
+ *
+ * dtsi 里写的是 SPI 号，实际中断号要 +32。用下面的宏做转换，
+ * 避免每次手算出错。
+ */
+
+#define RK3576_IRQ_SPI(n)       ((n) + 32)
+
+/* UART（来源：rk356x-base.dtsi）*/
+
+#define RK3576_IRQ_UART0        RK3576_IRQ_SPI(116)   /* 148 */
+#define RK3576_IRQ_UART1        RK3576_IRQ_SPI(117)   /* 149 */
+#define RK3576_IRQ_UART2        RK3576_IRQ_SPI(118)   /* 150 ← 调试口 */
+#define RK3576_IRQ_UART3        RK3576_IRQ_SPI(119)   /* 151 */
+#define RK3576_IRQ_UART4        RK3576_IRQ_SPI(120)   /* 152 */
+
+#endif /* __ARCH_ARM64_INCLUDE_RK3576_IRQ_H */
diff --git a/arch/arm64/src/rk3576/Kconfig b/arch/arm64/src/rk3576/Kconfig
new file mode 100644
index 00000000..d5f8c8c2
--- /dev/null
+++ b/arch/arm64/src/rk3576/Kconfig
@@ -0,0 +1,27 @@
+#
+# For a description of the syntax of this configuration file,
+# see the file kconfig-language.txt in the NuttX tools repository.
+#
+
+if ARCH_CHIP_RK3576
+
+menu "Rockchip RK3576 Peripheral Selection"
+
+comment "RK3576 的调试串口不在此处配置。"
+comment "DW 8250 与 16550 兼容，直接使用通用驱动："
+comment "  Device Drivers -> Serial Driver Support -> 16550 UART Chip support"
+comment "并在 defconfig 中填 16550_UART0_BASE / CLOCK / IRQ / BAUD。"
+
+config RK3576_UART0_IS_CONSOLE
+	bool "UART0 作为调试控制台"
+	default y
+	---help---
+		标记 RK3576 的调试控制台走 UART0（0x2ad40000，GIC_SPI 76 -> IRQ 108）。
+		本选项只作记录用途，实际基址、时钟与中断号由通用 16550 驱动提供。
+
+		已由 KICKPI 官方 Armbian 源码的 U-Boot defconfig 确认：
+		CONFIG_DEBUG_UART_BASE=0x2ad40000，即 UART0。
+
+endmenu # Rockchip RK3576 Peripheral Selection
+
+endif # ARCH_CHIP_RK3576
