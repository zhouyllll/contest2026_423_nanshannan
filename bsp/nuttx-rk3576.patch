+ *   返回 i2s_dev_s 句柄，供 drivers/audio/es8388.c 使用。
+ *   调用前须先 rk3576_sai_probe() 成功。
+ *
+ * Input Parameters:
+ *   port - SAI 实例号。板上 ES8388 接的是 SAI1，只支持 1。
+ *
+ ****************************************************************************/
+
+struct i2s_dev_s *rk3576_sai_initialize(int port);
+
+#endif /* __ARCH_ARM64_SRC_RK3576_RK3576_SAI_H */
