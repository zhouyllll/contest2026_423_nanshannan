+ *   寄存器写对了。返回 OK 表示观测到帧起始。
+ *
+ ****************************************************************************/
+
+int rk3576_vop2_check_scanning(int vp);
+
 #endif /* __ARCH_ARM64_SRC_RK3576_RK3576_VOP2_H */
