+#define __INCLUDE_NUTTX_TIMERS_HYM8563_H
+
+#include <nuttx/config.h>
+#include <stdint.h>
+#include <nuttx/i2c/i2c_master.h>
+
+/****************************************************************************
+ * Public Function Prototypes
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: hym8563_rtc_initialize
+ *
+ * Description:
+ *   把 HYM8563 注册为 /dev/rtc<minor>。注册前会读控制寄存器确认器件
+ *   在位；掉电标志置位时 rdtime 返回 -ENODATA，而不是交出随机时间。
+ *
+ ****************************************************************************/
+
+int hym8563_rtc_initialize(int minor, FAR struct i2c_master_s *i2c,
+                           uint8_t addr, uint32_t frequency);
+
+#endif /* __INCLUDE_NUTTX_TIMERS_HYM8563_H */
