diff --git a/drivers/timers/hym8563.c b/drivers/timers/hym8563.c
new file mode 100644
index 00000000..c27e73e7
--- /dev/null
+++ b/drivers/timers/hym8563.c
@@ -0,0 +1,563 @@
+/****************************************************************************
+ * drivers/timers/hym8563.c
+ *
+ * Haoyu HYM8563 I2C 实时时钟。
+ *
+ * 寄存器定义取自 Linux drivers/rtc/rtc-hym8563.c。
+ *
+ * ★ 掉电标志（秒寄存器 bit7，VL）是这颗芯片唯一能说明"时间可不可信"
+ *   的位。它置位表示电压曾经低到无法保证走时，读出来的时间是垃圾。
+ *   不检查它的话，上层会拿到一个看似合法、实则随机的时间，而且没有
+ *   任何迹象表明有问题 —— 这类错误比读不出来更难查。
+ *
+ * ★ 闹钟和周期唤醒（CONFIG_RTC_ALARM / CONFIG_RTC_PERIODIC）用系统定时器
+ *   实现，不用芯片的闹钟寄存器。
+ *
+ *   HYM8563 的闹钟只到分钟（分/时/日/星期四个寄存器，没有秒），走时
+ *   寄存器也只到秒；而 RTC 框架的闹钟是秒级的，xTS 的 cmocka_driver_rtc
+ *   要求 5 秒闹钟误差在 ±10ms 以内。芯片做不到，所以记一个"RTC 秒数 ↔
+ *   系统节拍"的锚点，把闹钟时刻换算成系统节拍，用 wdog 触发。
+ *
+ *   锚点在 settime 放开走时的那一刻记（STOP 置位时分频链清零，放开后
+ *   正好 1 秒进位，相位是准的）；开机没有 settime 时用初始化时读到的
+ *   时间，相位误差 <1 秒。代价是：闹钟不能在系统断电时把系统叫醒
+ *   ——  这颗芯片的 INT 脚本板也没有接到 SoC。
+ *
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <stdint.h>
+#include <stdbool.h>
+#include <string.h>
+#include <errno.h>
+#include <syslog.h>
+
+#include <nuttx/i2c/i2c_master.h>
+#include <nuttx/timers/rtc.h>
+#ifdef CONFIG_RTC_ARCH
+#  include <nuttx/timers/arch_rtc.h>
+#endif
+#include <nuttx/kmalloc.h>
+#if defined(CONFIG_RTC_ALARM) || defined(CONFIG_RTC_PERIODIC)
+#  include <time.h>
+#  include <nuttx/clock.h>
+#  include <nuttx/spinlock.h>
+#  include <nuttx/wdog.h>
+#endif
+
+#ifdef CONFIG_RTC_HYM8563
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+#define HYM8563_CTL1        0x00
+#define HYM8563_CTL1_STOP   (1 << 5)
+
+#define HYM8563_CTL2        0x01
+
+#define HYM8563_SEC         0x02
+#define HYM8563_SEC_VL      (1 << 7)   /* 掉电标志：置位表示时间不可信 */
+#define HYM8563_SEC_MASK    0x7f
+#define HYM8563_MIN_MASK    0x7f
+#define HYM8563_HOUR_MASK   0x3f
+#define HYM8563_DAY_MASK    0x3f
+#define HYM8563_WEEKDAY_MASK 0x07
+#define HYM8563_MONTH_CENTURY (1 << 7)
+#define HYM8563_MONTH_MASK  0x1f
+
+/****************************************************************************
+ * Private Types
+ ****************************************************************************/
+
+struct hym8563_dev_s
+{
+  struct rtc_lowerhalf_s      lower;   /* 必须是第一个成员 */
+  FAR struct i2c_master_s    *i2c;
+  uint8_t                     addr;
+  uint32_t                    freq;
+
+#ifdef CONFIG_RTC_ALARM
+  time_t                      anchor_sec;   /* 锚点：RTC 时间（秒）       */
+  clock_t                     anchor_tick;  /* 锚点：对应的系统节拍       */
+  struct wdog_s               alarm_wd;
+  rtc_alarm_callback_t        alarm_cb;
+  FAR void                   *alarm_arg;
+  struct rtc_time             alarm_time;
+  bool                        alarm_active;
+#endif
+
+#ifdef CONFIG_RTC_PERIODIC
+  struct wdog_s               periodic_wd;
+  rtc_wakeup_callback_t       periodic_cb;
+  FAR void                   *periodic_arg;
+  clock_t                     periodic_ticks;
+#endif
+};
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+static inline uint8_t bcd2bin(uint8_t v)
+{
+  return (v & 0x0f) + ((v >> 4) * 10);
+}
+
+static inline uint8_t bin2bcd(uint8_t v)
+{
+  return ((v / 10) << 4) | (v % 10);
+}
+
+static int hym8563_read(FAR struct hym8563_dev_s *priv, uint8_t reg,
+                        FAR uint8_t *buf, size_t len)
+{
+  struct i2c_msg_s msg[2];
+
+  msg[0].frequency = priv->freq;
+  msg[0].addr      = priv->addr;
+  msg[0].flags     = 0;
+  msg[0].buffer    = &reg;
+  msg[0].length    = 1;
+
+  msg[1].frequency = priv->freq;
+  msg[1].addr      = priv->addr;
+  msg[1].flags     = I2C_M_READ;
+  msg[1].buffer    = buf;
+  msg[1].length    = len;
+
+  return I2C_TRANSFER(priv->i2c, msg, 2);
+}
+
+static int hym8563_write(FAR struct hym8563_dev_s *priv, uint8_t reg,
+                         FAR const uint8_t *buf, size_t len)
+{
+  struct i2c_msg_s msg;
+  uint8_t tmp[8];
+
+  if (len + 1 > sizeof(tmp))
+    {
+      return -EINVAL;
+    }
+
+  tmp[0] = reg;
+  memcpy(&tmp[1], buf, len);
+
+  msg.frequency = priv->freq;
+  msg.addr      = priv->addr;
+  msg.flags     = 0;
+  msg.buffer    = tmp;
+  msg.length    = len + 1;
+
+  return I2C_TRANSFER(priv->i2c, &msg, 1);
+}
+
+/****************************************************************************
+ * Name: hym8563_rdtime
+ ****************************************************************************/
+
+static int hym8563_rdtime(FAR struct rtc_lowerhalf_s *lower,
+                          FAR struct rtc_time *rtctime)
+{
+  FAR struct hym8563_dev_s *priv = (FAR struct hym8563_dev_s *)lower;
+  uint8_t buf[7];
+  int ret;
+
+  ret = hym8563_read(priv, HYM8563_SEC, buf, sizeof(buf));
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  /* ★ 先看掉电标志再解释数据。置位时后面的值是随机的，返回它等于
+   * 给上层一个看似合法的错误时间。
+   */
+
+  if (buf[0] & HYM8563_SEC_VL)
+    {
+      syslog(LOG_WARNING,
+             "HYM8563: 掉电标志置位，时间不可信（需先 settime）\n");
+      return -ENODATA;
+    }
+
+  rtctime->tm_sec  = bcd2bin(buf[0] & HYM8563_SEC_MASK);
+  rtctime->tm_min  = bcd2bin(buf[1] & HYM8563_MIN_MASK);
+  rtctime->tm_hour = bcd2bin(buf[2] & HYM8563_HOUR_MASK);
+  rtctime->tm_mday = bcd2bin(buf[3] & HYM8563_DAY_MASK);
+  rtctime->tm_wday = bcd2bin(buf[4] & HYM8563_WEEKDAY_MASK);
+  rtctime->tm_mon  = bcd2bin(buf[5] & HYM8563_MONTH_MASK) - 1;
+
+  /* 世纪位在月份寄存器的 bit7：置位表示 20xx 之前的世纪。
+   * tm_year 以 1900 为基准。
+   */
+
+  rtctime->tm_year = bcd2bin(buf[6]) +
+                     ((buf[5] & HYM8563_MONTH_CENTURY) ? 0 : 100);
+  return OK;
+}
+
+/****************************************************************************
+ * Name: hym8563_settime
+ ****************************************************************************/
+
+static int hym8563_settime(FAR struct rtc_lowerhalf_s *lower,
+                           FAR const struct rtc_time *rtctime)
+{
+  FAR struct hym8563_dev_s *priv = (FAR struct hym8563_dev_s *)lower;
+  uint8_t buf[7];
+  uint8_t ctl1;
+  int ret;
+
+  /* 写时间之前必须停走时，否则可能写到一半被进位打断。 */
+
+  ret = hym8563_read(priv, HYM8563_CTL1, &ctl1, 1);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  ctl1 |= HYM8563_CTL1_STOP;
+  ret = hym8563_write(priv, HYM8563_CTL1, &ctl1, 1);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  buf[0] = bin2bcd(rtctime->tm_sec);    /* 写 0 到 VL 位，清掉电标志 */
+  buf[1] = bin2bcd(rtctime->tm_min);
+  buf[2] = bin2bcd(rtctime->tm_hour);
+  buf[3] = bin2bcd(rtctime->tm_mday);
+  buf[4] = bin2bcd(rtctime->tm_wday);
+  buf[5] = bin2bcd(rtctime->tm_mon + 1);
+  buf[6] = bin2bcd(rtctime->tm_year % 100);
+
+  if (rtctime->tm_year < 100)
+    {
+      buf[5] |= HYM8563_MONTH_CENTURY;
+    }
+
+  ret = hym8563_write(priv, HYM8563_SEC, buf, sizeof(buf));
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  /* 恢复走时 */
+
+  ctl1 &= ~HYM8563_CTL1_STOP;
+  ret = hym8563_write(priv, HYM8563_CTL1, &ctl1, 1);
+
+#ifdef CONFIG_RTC_ALARM
+  if (ret >= 0)
+    {
+      /* 放开 STOP 的这一刻就是新时间的整秒起点 */
+
+      priv->anchor_sec  = timegm((FAR struct tm *)rtctime);
+      priv->anchor_tick = clock_systime_ticks();
+    }
+#endif
+
+  return ret;
+}
+
+static bool hym8563_havesettime(FAR struct rtc_lowerhalf_s *lower)
+{
+  FAR struct hym8563_dev_s *priv = (FAR struct hym8563_dev_s *)lower;
+  uint8_t sec;
+
+  /* 掉电标志没置位，就说明走时未中断过，时间可信。 */
+
+  if (hym8563_read(priv, HYM8563_SEC, &sec, 1) < 0)
+    {
+      return false;
+    }
+
+  return (sec & HYM8563_SEC_VL) == 0;
+}
+
+#ifdef CONFIG_RTC_ALARM
+/****************************************************************************
+ * Name: hym8563_alarm_expire
+ *
+ * Description:
+ *   wdog 到期（中断上下文）。上层 rtc.c 的回调只做信号通知，可在这里调。
+ *
+ ****************************************************************************/
+
+static void hym8563_alarm_expire(wdparm_t arg)
+{
+  FAR struct hym8563_dev_s *priv = (FAR struct hym8563_dev_s *)arg;
+  rtc_alarm_callback_t cb = priv->alarm_cb;
+
+  priv->alarm_active = false;
+  if (cb != NULL)
+    {
+      cb(priv->alarm_arg, 0);
+    }
+}
+
+/* 锚点换算：RTC 时间 t（秒）对应的系统节拍 */
+
+static clock_t hym8563_sec2tick(FAR struct hym8563_dev_s *priv, time_t t)
+{
+  return priv->anchor_tick + SEC2TICK(t - priv->anchor_sec);
+}
+
+static int hym8563_setalarm(FAR struct rtc_lowerhalf_s *lower,
+                            FAR const struct lower_setalarm_s *alarminfo)
+{
+  FAR struct hym8563_dev_s *priv = (FAR struct hym8563_dev_s *)lower;
+  irqstate_t flags;
+
+  if (alarminfo->id != 0)
+    {
+      return -EINVAL;               /* 只有一个闹钟 */
+    }
+
+  flags = enter_critical_section();
+  priv->alarm_cb     = alarminfo->cb;
+  priv->alarm_arg    = alarminfo->priv;
+  priv->alarm_time   = alarminfo->time;
+  priv->alarm_active = true;
+  leave_critical_section(flags);
+
+  return wd_start_abstick(&priv->alarm_wd,
+                          hym8563_sec2tick(priv, timegm((FAR struct tm *)
+                                                  &alarminfo->time)),
+                          hym8563_alarm_expire, (wdparm_t)priv);
+}
+
+static int hym8563_setrelative(FAR struct rtc_lowerhalf_s *lower,
+                               FAR const struct lower_setrelative_s *info)
+{
+  FAR struct hym8563_dev_s *priv = (FAR struct hym8563_dev_s *)lower;
+  clock_t now = clock_systime_ticks();
+  time_t t;
+  irqstate_t flags;
+
+  if (info->id != 0 || info->reltime <= 0)
+    {
+      return -EINVAL;
+    }
+
+  /* 按锚点推出当前 RTC 秒数，给 rdalarm 用 */
+
+  t = priv->anchor_sec + TICK2SEC(now - priv->anchor_tick) + info->reltime;
+
+  flags = enter_critical_section();
+  priv->alarm_cb     = info->cb;
+  priv->alarm_arg    = info->priv;
+  gmtime_r(&t, (FAR struct tm *)&priv->alarm_time);
+  priv->alarm_active = true;
+  leave_critical_section(flags);
+
+  return wd_start(&priv->alarm_wd, SEC2TICK(info->reltime),
+                  hym8563_alarm_expire, (wdparm_t)priv);
+}
+
+static int hym8563_cancelalarm(FAR struct rtc_lowerhalf_s *lower,
+                               int alarmid)
+{
+  FAR struct hym8563_dev_s *priv = (FAR struct hym8563_dev_s *)lower;
+
+  if (alarmid != 0)
+    {
+      return -EINVAL;
+    }
+
+  priv->alarm_active = false;
+  wd_cancel(&priv->alarm_wd);
+  return OK;
+}
+
+static int hym8563_rdalarm(FAR struct rtc_lowerhalf_s *lower,
+                           FAR struct lower_rdalarm_s *alarminfo)
+{
+  FAR struct hym8563_dev_s *priv = (FAR struct hym8563_dev_s *)lower;
+
+  if (alarminfo->id != 0 || alarminfo->time == NULL)
+    {
+      return -EINVAL;
+    }
+
+  if (!priv->alarm_active)
+    {
+      return -ENOENT;
+    }
+
+  *alarminfo->time = priv->alarm_time;
+  return OK;
+}
+#endif /* CONFIG_RTC_ALARM */
+
+#ifdef CONFIG_RTC_PERIODIC
+static void hym8563_periodic_expire(wdparm_t arg)
+{
+  FAR struct hym8563_dev_s *priv = (FAR struct hym8563_dev_s *)arg;
+
+  /* 相对上一次到期时刻重装，不累积回调延迟 */
+
+  wd_start_next(&priv->periodic_wd, priv->periodic_ticks,
+                hym8563_periodic_expire, (wdparm_t)priv);
+
+  if (priv->periodic_cb != NULL)
+    {
+      priv->periodic_cb(priv->periodic_arg, 0);
+    }
+}
+
+static int hym8563_setperiodic(FAR struct rtc_lowerhalf_s *lower,
+                               FAR const struct lower_setperiodic_s *info)
+{
+  FAR struct hym8563_dev_s *priv = (FAR struct hym8563_dev_s *)lower;
+  clock_t ticks;
+
+  if (info->id != 0)
+    {
+      return -EINVAL;
+    }
+
+  ticks = SEC2TICK(info->period.tv_sec) + NSEC2TICK(info->period.tv_nsec);
+  if (ticks == 0)
+    {
+      return -EINVAL;
+    }
+
+  wd_cancel(&priv->periodic_wd);
+  priv->periodic_cb    = info->cb;
+  priv->periodic_arg   = info->priv;
+  priv->periodic_ticks = ticks;
+
+  return wd_start(&priv->periodic_wd, ticks, hym8563_periodic_expire,
+                  (wdparm_t)priv);
+}
+
+static int hym8563_cancelperiodic(FAR struct rtc_lowerhalf_s *lower,
+                                  int id)
+{
+  FAR struct hym8563_dev_s *priv = (FAR struct hym8563_dev_s *)lower;
+
+  if (id != 0)
+    {
+      return -EINVAL;
+    }
+
+  wd_cancel(&priv->periodic_wd);
+  priv->periodic_cb = NULL;
+  return OK;
+}
+#endif /* CONFIG_RTC_PERIODIC */
+
+static const struct rtc_ops_s g_hym8563_ops =
+{
+  .rdtime      = hym8563_rdtime,
+  .settime     = hym8563_settime,
+  .havesettime = hym8563_havesettime,
+#ifdef CONFIG_RTC_ALARM
+  .setalarm    = hym8563_setalarm,
+  .setrelative = hym8563_setrelative,
+  .cancelalarm = hym8563_cancelalarm,
+  .rdalarm     = hym8563_rdalarm,
+#endif
+#ifdef CONFIG_RTC_PERIODIC
+  .setperiodic    = hym8563_setperiodic,
+  .cancelperiodic = hym8563_cancelperiodic,
+#endif
+};
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: hym8563_rtc_initialize
+ *
+ * Description:
+ *   注册 HYM8563 为 /dev/rtcN。
+ *
+ ****************************************************************************/
+
+int hym8563_rtc_initialize(int minor, FAR struct i2c_master_s *i2c,
+                           uint8_t addr, uint32_t frequency)
+{
+  FAR struct hym8563_dev_s *priv;
+  uint8_t ctl[2];
+  int ret;
+
+  if (i2c == NULL)
+    {
+      return -EINVAL;
+    }
+
+  priv = kmm_zalloc(sizeof(struct hym8563_dev_s));
+  if (priv == NULL)
+    {
+      return -ENOMEM;
+    }
+
+  priv->lower.ops = &g_hym8563_ops;
+  priv->i2c       = i2c;
+  priv->addr      = addr;
+  priv->freq      = frequency;
+
+  /* ★ 先读一次控制寄存器确认芯片真的在总线上应答。
+   * 注册成功不等于器件存在 —— 这一点在本板的触摸上踩过。
+   */
+
+  ret = hym8563_read(priv, HYM8563_CTL1, ctl, 2);
+  if (ret < 0)
+    {
+      syslog(LOG_ERR, "ERROR: HYM8563 @0x%02x 无应答: %d\n", addr, ret);
+      kmm_free(priv);
+      return ret;
+    }
+
+  syslog(LOG_INFO, "HYM8563: 应答正常 CTL1=0x%02x CTL2=0x%02x\n",
+         ctl[0], ctl[1]);
+
+#ifdef CONFIG_RTC_ALARM
+  /* 开机锚点：读到的时间 ↔ 此刻节拍，相位误差 <1 秒（见文件头）。
+   * 掉电标志置位时读不出时间，锚点留 0，等第一次 settime 再定。
+   */
+
+  {
+    struct rtc_time now;
+
+    if (hym8563_rdtime(&priv->lower, &now) >= 0)
+      {
+        priv->anchor_sec  = timegm((FAR struct tm *)&now);
+        priv->anchor_tick = clock_systime_ticks();
+      }
+  }
+#endif
+
+  ret = rtc_initialize(minor, (FAR struct rtc_lowerhalf_s *)priv);
+  if (ret < 0)
+    {
+      syslog(LOG_ERR, "ERROR: 注册 /dev/rtc%d 失败: %d\n", minor, ret);
+      kmm_free(priv);
+      return ret;
+    }
+
+#ifdef CONFIG_RTC_ARCH
+  /* ★ rtc_initialize() 只是注册 /dev/rtcN 这个字符设备，系统时钟并不
+   * 会因此用上它。要让开机自动恢复时间，还得把下半部交给 arch_rtc：
+   *
+   *     up_rtc_set_lowerhalf(lower, sync)
+   *
+   * sync=true 会立刻用 RTC 的值同步系统时钟。掉电标志置位时 rdtime
+   * 返回 -ENODATA，clock_synchronize() 会保持原有时间，不会写入垃圾值。
+   */
+
+  up_rtc_set_lowerhalf((FAR struct rtc_lowerhalf_s *)priv, true);
+#endif
+
+  return OK;
+}
+
+#endif /* CONFIG_RTC_HYM8563 */
diff --git a/include/nuttx/timers/hym8563.h b/include/nuttx/timers/hym8563.h
new file mode 100644
