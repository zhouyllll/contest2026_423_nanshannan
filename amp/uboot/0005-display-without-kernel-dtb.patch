+/*
+ * AMP 路径下的退路：没有 resource 段也要把显示链点亮。
+ *
+ * ★ 为什么需要
+ *
+ *   display_logo() 是整个文件里**唯一**会调用 display_init() /
+ *   display_enable() 的地方 —— 也就是唯一会真正配置面板初始化序列、
+ *   D-PHY、DSI 和 VOP2 时序的地方。而 rockchip_show_logo() 只在
+ *   load_bmp_logo() 成功之后才调它。
+ *
+ *   load_bmp_logo() 读的是 resource 段里的 logo.bmp。AMP 这条路把 boot
+ *   分区换成了裸 Linux Image，没有 resource 段，于是 logo 读不到、
+ *   display_logo() 不被调用、屏幕全黑 —— 日志里连一行 DRM 输出都没有。
+ *
+ *   后果不是"少个开机 logo"这么轻：openvela 的显示驱动是**接管** U-Boot
+ *   已经点亮的链路（board/kickpi-k7 的 KEEP_UBOOT_DISPLAY），时序是从
+ *   VOP2 寄存器读回来的。屏没点亮时读到的是上电默认值（VP1 400x240），
+ *   /dev/fb0 就成了 200x240，LVGL 无处可画。
+ *
+ * ★ 为什么"全黑的缓冲"就够
+ *
+ *   openvela 的帧缓冲是它自己在 heap 上分配、再写进 VOP2 的 MST
+ *   （chip/rk3576/rk3576_fb.c），并不复用 U-Boot 的那一块。它需要 U-Boot
+ *   留下的只有"链路已配好 + 时序正确"这两点。所以这里不需要有图可画，
+ *   按面板自己的时序给一块全黑的全屏缓冲、走同一条 display_logo() 即可。
+ */
+static int display_blank(struct display_state *state)
+{
+	struct logo_info *logo = &state->logo;
+	void *fb;
+	int w, h, size;
+
+	if (display_init(state) || !state->is_init)
+		return -ENODEV;
+
+	w = state->conn_state.mode.crtc_hdisplay;
+	h = state->conn_state.mode.vdisplay;
+	if (w <= 0 || h <= 0)
+		return -EINVAL;
+
+	size = w * h * 4;
+	fb = get_display_buffer(size);
+	if (!fb)
+		return -ENOMEM;
+
+	memset(fb, 0, size);
+	flush_dcache_range((ulong)fb,
+			   ALIGN((ulong)fb + size, CONFIG_SYS_CACHELINE_SIZE));
+
+	/* src 和 crtc 同尺寸，不经缩放 —— FULLSCREEN 和居中在这里等价，
+	 * 但两个字段都写上，免得日后 display_logo() 只看其中一个。
+	 */
+	state->logo_mode = ROCKCHIP_DISPLAY_FULLSCREEN;
+
+	memset(logo, 0, sizeof(*logo));
+	logo->mode   = ROCKCHIP_DISPLAY_FULLSCREEN;
+	logo->mem    = fb;
+	logo->width  = w;
+	logo->height = h;
+	logo->bpp    = 32;
+
+	printf("display blank %dx%d @%p (no resource logo)\n", w, h, fb);
+
+	return display_logo(state);
+}
+
 int rockchip_show_logo(void)
 {
 	struct display_state *s;
@@ -1569,6 +1635,7 @@
 		s->logo.rotate = s->logo_rotate;
 		if (load_bmp_logo(&s->logo, s->ulogo_name)) {
 			printf("failed to display uboot logo\n");
+			ret = display_blank(s);
 		} else {
 			ret = display_logo(s);
 			if (ret == -EAGAIN)
