从内存里启动 AMP：新增 `bootamp <addr>` 命令

★ 为什么不用官方那条路

官方的 amp_cpus_on() 写死了从**名为 "amp" 的分区**读 FIT
（drivers/cpu/rockchip_amp.c 里的 AMP_PART），而且在 rk_board_late_init()
里无条件执行。板上现在这张 GPT 是 Android 的，没有 amp 分区，要用就得
先改分区表。

改分区表是这件事里代价最不对称的一步：它和刷 bootloader 一样只能靠
maskrom 恢复，却只是为了给一段**还在调试中**的引导流程找个落脚点。
把 FIT 先放进内存再启动就完全绕开了它 —— 分区表一个字节不动，调试期
可以直接灌进 RAM，一轮迭代不写任何存储介质。

★ 保留默认启动路径

bootamp 是一条**手动**命令，默认 bootcmd 不变。AMP 试炸了，下一次上电
仍然走原来的路进普通系统。调试期不能把唯一的退路也押上去。

★ 复用而不是重写

真正的工作（解析 amp-dispatcher、加载 loadables、按 cpu 拉核、最后把
当前核送进非 Linux 的那个 OS）全在 brought_up_all_amp() 里，与 FIT 从
哪来无关。所以只是把 amp_cpus_on() 里"从分区读到内存"那一段换掉，
其余原样复用，新增代码几十行。

应用：在 u-boot/ 下 `patch -p1 < 本文件`

--- a/drivers/cpu/rockchip_amp.c
+++ b/drivers/cpu/rockchip_amp.c
@@ -437,6 +437,54 @@
 	return 0;
 }
 
+/*
+ * amp_cpus_on_at - 从内存里已经准备好的 FIT 启动 AMP
+ *
+ * 与 amp_cpus_on() 的唯一区别是 FIT 从哪来。真正的工作（解析
+ * amp-dispatcher、加载 loadables、按 cpu 拉核、最后把当前核送进非
+ * Linux 的那个 OS）全在 brought_up_all_amp() 里，与来源无关，所以这里
+ * 只是把"从分区读到内存"那一段换成"已经在内存里了"。
+ *
+ * 官方的 amp_cpus_on() 写死了名为 "amp" 的分区。板上这张 GPT 是
+ * Android 的，没有这个分区，要用就得改分区表 —— 而改分区表和刷
+ * bootloader 一样只能靠 maskrom 恢复。调试阶段不值得为一个还没跑通的
+ * 引导流程押上它，所以留一条"先进 RAM 再启动"的路。
+ *
+ * 调用方负责把整个 FIT（含 external data）放到 fit 指向的地方。
+ */
+int amp_cpus_on_at(void *fit)
+{
+	bootm_headers_t images;
+	int ret;
+
+	if (fdt_check_header(fit)) {
+		AMP_E("Not a FIT at %p\n", fit);
+		return -EINVAL;
+	}
+
+	ret = parse_os_amp_dispatcher();
+	if (ret < 0)
+		return -EINVAL;
+
+	memset(&images, 0, sizeof(images));
+	images.fit_uname_cfg = "conf";
+	images.fit_hdr_os = fit;
+	images.verify = 1;
+
+	ret = boot_get_loadable(0, NULL, &images, IH_ARCH_DEFAULT, NULL, NULL);
+	if (ret) {
+		AMP_E("Load loadables, ret=%d\n", ret);
+		return ret;
+	}
+	flush_dcache_all();
+
+	ret = brought_up_all_amp(images.fit_hdr_os, images.fit_uname_cfg);
+	if (ret)
+		AMP_E("Brought up amps, ret=%d\n", ret);
+
+	return ret;
+}
+
 int amp_cpus_on(void)
 {
 	struct blk_desc *dev_desc;
--- a/include/amp.h
+++ b/include/amp.h
@@ -29,6 +29,7 @@
 		((MAP_SECURE(secure) & 0x1) << MODE_SECURE_SHIFT))
 
 int amp_cpus_on(void);
+int amp_cpus_on_at(void *fit);
 int arm64_switch_amp_pe(bootm_headers_t *images);
 
 #endif	/* _AMP_H_ */
--- a/cmd/Makefile
+++ b/cmd/Makefile
@@ -9,6 +9,7 @@
 # core command
 obj-y += boot.o
 obj-$(CONFIG_CMD_BOOTM) += bootm.o
+obj-$(CONFIG_AMP) += bootamp.o
 obj-y += help.o
 obj-y += version.o
 
--- /dev/null
+++ b/cmd/bootamp.c
@@ -0,0 +1,61 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * bootamp - 从内存里的 AMP FIT 启动双 OS
+ *
+ * Copyright (c) 2026 contest2026_423_nanshannan
+ *
+ * 用法：
+ *	bootamp <FIT 在内存里的地址>
+ *
+ * 例：
+ *	mmc read 0x60000000 0xC800 0x4000
+ *	bootamp 0x60000000
+ *
+ * ★ 这条命令不会返回。
+ *
+ *   brought_up_all_amp() 的最后一步是把**当前这颗核**送进 FIT 里
+ *   cpu = <当前 MPIDR> 的那个镜像（armv8_switch_to_el2）。所以它成功了
+ *   就再也回不来，失败才返回 —— 返回值非 0 一定是出错。
+ *
+ * ★ 为什么做成手动命令而不是挂进 bootcmd
+ *
+ *   AMP 起不来的时候，板子必须还能进普通系统。默认 bootcmd 保持不变，
+ *   下一次上电就是原来的样子；要试 AMP 就在 U-Boot 提示符下显式敲。
+ *   调试期不能把唯一的退路也押上去。
+ */
+
+#include <common.h>
+#include <amp.h>
+#include <command.h>
+
+static int do_bootamp(cmd_tbl_t *cmdtp, int flag, int argc, char *const argv[])
+{
+	void *fit;
+	int ret;
+
+	if (argc != 2)
+		return CMD_RET_USAGE;
+
+	fit = (void *)simple_strtoul(argv[1], NULL, 16);
+
+	printf("AMP: booting from FIT at %p\n", fit);
+
+	ret = amp_cpus_on_at(fit);
+
+	/* 到这里说明没起来 —— 成功的话当前核已经跳走了。 */
+
+	printf("AMP: failed, ret=%d (板子仍在 U-Boot，可以重来)\n", ret);
+
+	return CMD_RET_FAILURE;
+}
+
+U_BOOT_CMD(
+	bootamp, 2, 0, do_bootamp,
+	"boot an AMP FIT that is already in memory",
+	"<addr>\n"
+	"    - <addr>: hex address of the AMP FIT image\n"
+	"\n"
+	"The FIT describes which image runs on which CPU (by MPIDR).\n"
+	"On success this command does not return: the current CPU enters\n"
+	"the image whose 'cpu' property matches its own MPIDR.\n"
+);
