+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * bootamp - 从内存里的 AMP FIT 启动双 OS
+ *
+ * Copyright (c) 2026 contest2026_423_nanshannan
+ *
+ * 用法：
+ *	bootamp <FIT 在内存里的地址>
+ *
+ * 例：
+ *	mmc read 0x60000000 0xC800 0x4000
+ *	bootamp 0x60000000
+ *
+ * ★ 这条命令不会返回。
+ *
+ *   brought_up_all_amp() 的最后一步是把**当前这颗核**送进 FIT 里
+ *   cpu = <当前 MPIDR> 的那个镜像（armv8_switch_to_el2）。所以它成功了
+ *   就再也回不来，失败才返回 —— 返回值非 0 一定是出错。
+ *
+ * ★ 为什么做成手动命令而不是挂进 bootcmd
+ *
+ *   AMP 起不来的时候，板子必须还能进普通系统。默认 bootcmd 保持不变，
+ *   下一次上电就是原来的样子；要试 AMP 就在 U-Boot 提示符下显式敲。
+ *   调试期不能把唯一的退路也押上去。
+ */
+
+#include <common.h>
+#include <amp.h>
+#include <command.h>
+
+static int do_bootamp(cmd_tbl_t *cmdtp, int flag, int argc, char *const argv[])
+{
+	void *fit;
+	int ret;
+
+	if (argc != 2)
+		return CMD_RET_USAGE;
+
+	fit = (void *)simple_strtoul(argv[1], NULL, 16);
+
+	printf("AMP: booting from FIT at %p\n", fit);
+
+	ret = amp_cpus_on_at(fit);
+
+	/* 到这里说明没起来 —— 成功的话当前核已经跳走了。 */
+
+	printf("AMP: failed, ret=%d (板子仍在 U-Boot，可以重来)\n", ret);
+
+	return CMD_RET_FAILURE;
+}
+
+U_BOOT_CMD(
+	bootamp, 2, 0, do_bootamp,
+	"boot an AMP FIT that is already in memory",
+	"<addr>\n"
+	"    - <addr>: hex address of the AMP FIT image\n"
+	"\n"
+	"The FIT describes which image runs on which CPU (by MPIDR).\n"
+	"On success this command does not return: the current CPU enters\n"
+	"the image whose 'cpu' property matches its own MPIDR.\n"
+);
