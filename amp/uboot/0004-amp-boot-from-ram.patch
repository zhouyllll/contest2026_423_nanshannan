+/*
+ * amp_cpus_on_at - 从内存里已经准备好的 FIT 启动 AMP
+ *
+ * 与 amp_cpus_on() 的唯一区别是 FIT 从哪来。真正的工作（解析
+ * amp-dispatcher、加载 loadables、按 cpu 拉核、最后把当前核送进非
+ * Linux 的那个 OS）全在 brought_up_all_amp() 里，与来源无关，所以这里
+ * 只是把"从分区读到内存"那一段换成"已经在内存里了"。
+ *
+ * 官方的 amp_cpus_on() 写死了名为 "amp" 的分区。板上这张 GPT 是
+ * Android 的，没有这个分区，要用就得改分区表 —— 而改分区表和刷
+ * bootloader 一样只能靠 maskrom 恢复。调试阶段不值得为一个还没跑通的
+ * 引导流程押上它，所以留一条"先进 RAM 再启动"的路。
+ *
+ * 调用方负责把整个 FIT（含 external data）放到 fit 指向的地方。
+ */
+int amp_cpus_on_at(void *fit)
+{
+	bootm_headers_t images;
+	int ret;
+
+	if (fdt_check_header(fit)) {
+		AMP_E("Not a FIT at %p\n", fit);
+		return -EINVAL;
+	}
+
+	ret = parse_os_amp_dispatcher();
+	if (ret < 0)
+		return -EINVAL;
+
+	memset(&images, 0, sizeof(images));
+	images.fit_uname_cfg = "conf";
+	images.fit_hdr_os = fit;
+	images.verify = 1;
+
+	ret = boot_get_loadable(0, NULL, &images, IH_ARCH_DEFAULT, NULL, NULL);
+	if (ret) {
+		AMP_E("Load loadables, ret=%d\n", ret);
+		return ret;
+	}
+	flush_dcache_all();
+
+	ret = brought_up_all_amp(images.fit_hdr_os, images.fit_uname_cfg);
+	if (ret)
+		AMP_E("Brought up amps, ret=%d\n", ret);
+
+	return ret;
+}
+
 int amp_cpus_on(void)
 {
 	struct blk_desc *dev_desc;
