+/* eMMC 上的默认布局，和 amp/FLASH.md 那张表一一对应。
+ *
+ * 扇区数取的是**上限**而不是精确值：多读几个扇区没有副作用，而写死精确
+ * 值意味着每次镜像变大都要同步改两处（这里和文档），漏一处就是"读进来
+ * 的 FIT 少了尾巴"这种很难看出来的故障。上限都留在各自分区内：
+ *   FIT   8192 + 5120 = 13312 < 14336（dtb）
+ *   dtb  14336 +  544 = 14880 < 16384（uboot 分区）
+ *   内核 49152 +14848 = 64000 < 65536（rkdeveloptool 写得到的上限）
+ */
+
+#define AMP_FIT_LBA		0x2000		/*  8192 */
+#define AMP_FIT_CNT		0x1400		/*  5120 扇区 = 2.5MB 上限 */
+#define AMP_DTB_LBA		0x3800		/* 14336 */
+#define AMP_DTB_CNT		0x220		/*   544 扇区 = 272KB 上限 */
+#define AMP_KERNEL_LBA		0xC000		/* 49152 */
+#define AMP_KERNEL_CNT		0x3A00		/* 14848 扇区 = 7.25MB 上限 */
+
+#define AMP_FIT_ADDR		0x60000000
+#define AMP_DTB_ADDR		0x4f000000
+#define AMP_KERNEL_ADDR		0x40400000
+
+static int amp_load_from_mmc(void)
+{
+	char cmd[128];
+	int ret;
+
+	ret = run_command("mmc dev 0", 0);
+	if (ret)
+		return ret;
+
+	snprintf(cmd, sizeof(cmd), "mmc read 0x%x 0x%x 0x%x",
+		 AMP_KERNEL_ADDR, AMP_KERNEL_LBA, AMP_KERNEL_CNT);
+	ret = run_command(cmd, 0);
+	if (ret)
+		return ret;
+
+	snprintf(cmd, sizeof(cmd), "mmc read 0x%x 0x%x 0x%x",
+		 AMP_DTB_ADDR, AMP_DTB_LBA, AMP_DTB_CNT);
+	ret = run_command(cmd, 0);
+	if (ret)
+		return ret;
+
+	snprintf(cmd, sizeof(cmd), "mmc read 0x%x 0x%x 0x%x",
+		 AMP_FIT_ADDR, AMP_FIT_LBA, AMP_FIT_CNT);
+	ret = run_command(cmd, 0);
+	if (ret)
+		return ret;
+
+	/* ★ devtype/devnum 必须有值，否则 booti 会在 strcmp(NULL) 上炸
+	 *
+	 *   common/bootm.c 的 bootm_disable_interrupts() 里是
+	 *
+	 *       if (!strcmp(env_get("devtype"), "usb"))
+	 *
+	 *   没有判空。平时这两个变量由 setup_boot_dev() 设好，但关掉
+	 *   CONFIG_USING_KERNEL_DTB 之后（见 0005 补丁）它跑在环境变量初始化
+	 *   **之前** —— 日志里是 `Bootdev(atags): <NULL> <NULL>`，而原来是
+	 *   `Bootdev(atags): mmc 0`。于是 env_get 返回 NULL，booti 走到
+	 *   bootm_disable_interrupts() 就 data abort：
+	 *
+	 *       "Synchronous Abort" handler, esr 0x96000006
+	 *       PC = strcmp+8, x0 = 0, x1 -> "usb"
+	 *
+	 *   我们这条路本来就是从 eMMC 读的，直接把真实值补上。
+	 *   （bootm.c 那个判空也一并修了，见同一份补丁。）
+	 */
+
+	env_set("devtype", "mmc");
+	env_set("devnum", "0");
+
+	/* 已经设过就不动 —— 手工覆盖优先于默认值。 */
+
+	if (!env_get("amp_linux_cmd")) {
+		snprintf(cmd, sizeof(cmd), "booti 0x%x - 0x%x",
+			 AMP_KERNEL_ADDR, AMP_DTB_ADDR);
+		env_set("amp_linux_cmd", cmd);
+	}
+
+	printf("AMP: loaded kernel@0x%x dtb@0x%x fit@0x%x from eMMC\n",
+	       AMP_KERNEL_ADDR, AMP_DTB_ADDR, AMP_FIT_ADDR);
+
+	return 0;
+}
 
