# KICKPI-K7 AMP：把 Linux 削到只剩 AMP 需要的东西
#
# ★ 为什么必须瘦
#
#   rockchip_linux_defconfig 编出来的 Image 是 43MB。而 rkdeveloptool
#   这条 USB 通道**写不到 32MB 以上**（已逐项验证：LBA 65528 写入后回读
#   一致，70000 写入后回读全 0xCC；换 rkbin 的 spl_loader、换 wlx 走分区
#   路径，都一样。同一个 LBA 用 U-Boot 的 mmc write 却成功——所以限制在
#   USB 通道，不在 eMMC）。
#
#   boot 分区从 LBA 51200 = 25MB 起，到 32MB 上限只剩 7MB。43MB 的内核
#   尾巴必然越界，而且是**静默**越界：命令报 100%，数据没写进去。
#
#   绕路的办法有（借分区当中转站分段搬、做 SD 启动卡、串口 loady），
#   但都是在迁就一个不必要的 43MB。
#
# ★ 削掉的东西本来就不该在里面
#
#   AMP 下这些外设归 openvela：显示（VOP2/DSI）、摄像头、音频（SAI/
#   ES8388）、SD/eMMC、以太网、USB。Linux 这一侧带着它们的驱动，不只是
#   浪费空间 —— 是**两个 OS 会同时去初始化同一个控制器**。所以关掉它们
#   既是为了体积，也是资源划分本身。
#
#   留下来的是 AMP 真正需要的：PSCI（拉 A72 的另外三核）、GIC、arch
#   timer、CRU（给 mailbox 开 pclk）、mailbox、rpmsg。
#
# 用法：
#   make ARCH=arm64 CROSS_COMPILE=<tc> rockchip_linux_defconfig rk3576.config
#   ./scripts/kconfig/merge_config.sh -m -O . .config amp.config amp-minimal.config
#   make ARCH=arm64 CROSS_COMPILE=<tc> olddefconfig Image

# ---- 必须保留 ----
CONFIG_MAILBOX=y
CONFIG_ROCKCHIP_MBOX=y
CONFIG_RPMSG=y
CONFIG_RPMSG_VIRTIO=y
CONFIG_RPMSG_ROCKCHIP_MBOX=y
CONFIG_RPMSG_NS=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_NR_CPUS=4
# 没有控制台也要留 earlycon：以后往 40pin 上接第二个 USB-TTL 就能看日志
CONFIG_SERIAL_EARLYCON=y

# ---- 图形 / GPU：整个子系统归 openvela ----
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_MALI_BIFROST is not set
# CONFIG_MALI_MIDGARD is not set
# CONFIG_BACKLIGHT_CLASS_DEVICE is not set
# CONFIG_LOGO is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set

# ---- 摄像头 / 视频编解码 / NPU ----
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_VIDEO_DEV is not set
# CONFIG_ROCKCHIP_RKNPU is not set
# CONFIG_ROCKCHIP_MPP_SERVICE is not set
# CONFIG_ROCKCHIP_RGA is not set

# ---- 音频：SAI + ES8388 归 openvela ----
# CONFIG_SOUND is not set
# CONFIG_SND is not set
# CONFIG_SND_SOC is not set

# ---- 存储：SD/eMMC 归 openvela（Linux 侧连根文件系统都不要）----
# CONFIG_MMC is not set
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_NVME_CORE is not set
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_SCSI_UFSHCD is not set
# CONFIG_MTD is not set

# ---- 网络：以太网归 openvela ----
#
# 关 NET 会连带关掉 RPMSG_CHAR（drivers/rpmsg/Kconfig 里它 depends on NET，
# 因为 rpmsg_char 走的是 socket 那套）。这一版接受这个代价：
#
#   第一个 AMP 里程碑的存活判据是**握手本身** —— Linux 跑到
#   rockchip_rpmsg_probe、建好两个 virtqueue、发出第一次门铃，openvela
#   那边 ampctl status 的"握手完成"就变成"是"。这条路径全在内核里，
#   不需要用户态，也不需要 /dev/rpmsgN。
#
#   等要做用户态的计算域守护进程时再把 NET + RPMSG_CHAR 开回来；
#   那时内核会变大，但那时也不再受 32MB 限制（可以走 SD 卡或分段中转）。
# CONFIG_NET is not set
# CONFIG_WIRELESS is not set
# CONFIG_BT is not set
# CONFIG_CFG80211 is not set

# ---- USB ----
# CONFIG_USB_SUPPORT is not set
# CONFIG_USB is not set
# CONFIG_USB_GADGET is not set

# ---- 文件系统：只留内存里的几个 ----
# CONFIG_EXT4_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_FAT_FS is not set
# CONFIG_NTFS3_FS is not set
# CONFIG_OVERLAY_FS is not set
# CONFIG_SQUASHFS is not set
# CONFIG_FUSE_FS is not set
# CONFIG_NLS is not set

# ---- 输入 / HID ----
# CONFIG_INPUT is not set
# CONFIG_HID is not set

# ---- 调频 / 休眠：AMP 下动这些会关掉 openvela 还在用的时钟和电源域 ----
# CONFIG_CPU_FREQ is not set
# CONFIG_CPU_IDLE is not set
# CONFIG_SUSPEND is not set
# CONFIG_PM_DEVFREQ is not set

# ---- 其它大块 ----
# CONFIG_MODULES is not set
# CONFIG_CRYPTO_USER_API is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set
# CONFIG_BLK_DEV_INITRD is not set
# CONFIG_KVM is not set
# CONFIG_VIRTUALIZATION is not set
CONFIG_DEBUG_INFO_NONE=y

# ---- PHY：显示 / 摄像头 / USB / PCIe 的 PHY 都跟着主体一起关 ----
#
# 这里有一个必须关的理由不是体积：drivers/phy/rockchip/
# phy-rockchip-samsung-dcphy.c 直接用了 struct v4l2_subdev 的 entity
# 成员，却没有按 CONFIG_MEDIA_SUPPORT 加守卫。MEDIA_SUPPORT 一关，
# 它就编不过（'struct v4l2_subdev' has no member named 'entity'）。
# 厂商驱动的这类漏守卫不值得去改，关掉就行 —— MIPI DCPHY 本来就归
# openvela（显示与摄像头都在那一侧）。
# CONFIG_PHY_ROCKCHIP_SAMSUNG_DCPHY is not set
# CONFIG_PHY_ROCKCHIP_INNO_DSIDPHY is not set
# CONFIG_PHY_ROCKCHIP_SAMSUNG_HDPTX is not set
# CONFIG_PHY_ROCKCHIP_SAMSUNG_HDPTX_HDMI is not set
# CONFIG_PHY_ROCKCHIP_INNO_HDMI is not set
# CONFIG_PHY_ROCKCHIP_DP is not set
# CONFIG_PHY_ROCKCHIP_NANENG_EDP is not set
# CONFIG_PHY_ROCKCHIP_TYPEC is not set
# CONFIG_PHY_ROCKCHIP_USB is not set
# CONFIG_PHY_ROCKCHIP_USBDP is not set
# CONFIG_PHY_ROCKCHIP_INNO_USB3 is not set
# CONFIG_PHY_ROCKCHIP_EMMC is not set
# CONFIG_PHY_ROCKCHIP_PCIE is not set
# CONFIG_PHY_ROCKCHIP_SNPS_PCIE3 is not set
# CONFIG_PHY_ROCKCHIP_NANENG_COMBO_PHY is not set
# CONFIG_PCIE_ROCKCHIP_DW_HOST is not set
# CONFIG_PCI is not set

# 同一类问题：drivers/soc/rockchip/rockchip_pm_config.c 用了
# mem_sleep_current，那个符号只在 CONFIG_SUSPEND 下存在，而它自己没守卫。
# 系统挂起在 AMP 下本来就必须关（一边挂起会关掉另一边还在用的时钟和
# 电源域），所以连带把这个驱动也关掉。
# CONFIG_ROCKCHIP_SUSPEND_MODE is not set

# Mali：关 DRM 之后 mali400 的 rk 平台胶水层编不过（struct mali_device
# 的定义在被 DRM 相关开关守卫的头里）。GPU 在 AMP 下没有主人 —— 两个
# OS 都不该去初始化它 —— 直接关。
# CONFIG_MALI400 is not set
# CONFIG_MALI450 is not set
# CONFIG_MALI_DVFS is not set
# CONFIG_MALI_DT is not set

# 电池 / 电源供给：K7 是开发板，没有电池。rk817_battery 也是漏守卫
# （关 SUSPEND 后 resume_work 声明了没定义）。PMIC 的调压归 U-Boot 和
# openvela，Linux 这一侧不需要。
# CONFIG_POWER_SUPPLY is not set
# CONFIG_CHARGER_RK817 is not set
# CONFIG_BATTERY_RK817 is not set
# CONFIG_FUEL_GAUGE_RK817 is not set

# RK628 是外挂的桥接芯片（HDMI-in / LVDS 转换），K7 上没有，而且它的
# panel.c 依赖 backlight 子系统（已关）。
# CONFIG_RK628_MISC is not set

# ---- 第二轮：14.7MB → 更小 ----
#
# INPUT 关不掉 —— drivers/tty/Kconfig 的 VT 会 select INPUT。所以改成
# 把它下面那一堆触摸屏驱动关掉（461KB 全是 K7 用不到的型号；触摸屏在
# AMP 下归 openvela，LVGL 那一侧已经在用 FT5x06）。
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_INPUT_JOYSTICK is not set
# CONFIG_INPUT_MISC is not set
# CONFIG_VT is not set

# 追踪与 BPF：AMP 第一个里程碑不需要，合计接近 1MB
# CONFIG_FTRACE is not set
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_TRACING is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_DYNAMIC_DEBUG is not set
# CONFIG_KALLSYMS_ALL is not set

# 文件系统：没有根文件系统，只留内存里的
# CONFIG_EROFS_FS is not set
# CONFIG_JFFS2_FS is not set
# CONFIG_UBIFS_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_CIFS is not set
# CONFIG_QUOTA is not set
# CONFIG_FS_ENCRYPTION is not set
# CONFIG_FS_VERITY is not set

# 耳机插拔检测：跟音频一起归 openvela（那边 ES8388 的耳机口已经在用）。
# 它用 input 子系统，而关掉 VT 之后 INPUT 就没了。
# CONFIG_RK_HEADSET is not set

# ---- 第三轮：10.6MB → ≤7MB ----
#
# 目标很具体：boot 分区从 LBA 51200 起，rkdeveloptool 只能写到 65536，
# 中间正好 14336 扇区 = 7MB。压进 7MB 就只动 boot 一个分区，dtbo /
# vbmeta / recovery 全都不用碰 —— 事后 flash.sh --raw 一条命令就能把
# NuttX 烧回去，不留任何别的痕迹。
#
# 下面这些都是「AMP 下不归 Linux」或「第一个里程碑不需要」的：

# 内核自带的配置副本（949KB 的 printk 里很大一块是 IKCONFIG + 各种字符串）
# CONFIG_IKCONFIG is not set
# CONFIG_IKCONFIG_PROC is not set
# CONFIG_PRINTK_INDEX is not set

# 压缩算法：没有 initrd、没有 EROFS、不加载模块，一个都用不到
# CONFIG_ZSTD_COMPRESS is not set
# CONFIG_ZSTD_DECOMPRESS is not set
# CONFIG_CRYPTO_ZSTD is not set
# CONFIG_CRYPTO_LZ4 is not set
# CONFIG_CRYPTO_LZ4HC is not set
# CONFIG_CRYPTO_DEFLATE is not set
# CONFIG_CRYPTO_HW is not set
# CONFIG_CRYPTO_DEV_ROCKCHIP is not set

# 这些外设在 AMP 里全部归 openvela：I2C（ES8388/触摸/RTC）、SPI、PWM、
# SARADC、看门狗、LED、RTC。Linux 这一侧带着驱动只会和它抢控制器。
# CONFIG_I2C is not set
# CONFIG_SPI is not set
# CONFIG_PWM is not set
# CONFIG_IIO is not set
# CONFIG_WATCHDOG is not set
# CONFIG_LEDS_CLASS is not set
# CONFIG_RTC_CLASS is not set
# CONFIG_HWMON is not set
# CONFIG_THERMAL is not set
# CONFIG_IOMMU_SUPPORT is not set
# CONFIG_DMADEVICES is not set

# 块设备层：没有任何块设备
# CONFIG_BLOCK is not set

# 其它
# CONFIG_KALLSYMS is not set
# CONFIG_PROFILING is not set
# CONFIG_PERF_EVENTS is not set
# CONFIG_KPROBES is not set
# CONFIG_STACKTRACE is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_DEBUG_KERNEL is not set

# ---- 第四轮：8.2MB → ≤6.7MB（给 DTB 留 272KB 余量）----
#
# 这一版 Linux 不跑用户态：没有 init、没有根文件系统、没有 shell。
# 它的全部工作是「起来、把 GIC 配好、probe rockchip_rpmsg、按第一次门铃」。
# 所以进程隔离、安全模块、cgroup、coredump 这些面向多进程环境的机制
# 一件都不需要。
# CONFIG_CGROUPS is not set
# CONFIG_NAMESPACES is not set
# CONFIG_AUDIT is not set
# CONFIG_SECURITY is not set
# CONFIG_SECURITY_SELINUX is not set
# CONFIG_COREDUMP is not set
# CONFIG_ELF_CORE is not set
# CONFIG_SWAP is not set
# CONFIG_ZRAM is not set
# CONFIG_ZSMALLOC is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_PSTORE is not set
# CONFIG_CONFIGFS_FS is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_SHMEM is not set
# CONFIG_AIO is not set
# CONFIG_MEMCG is not set
# CONFIG_PAGE_POOL is not set
# CONFIG_UNIX98_PTYS is not set
# CONFIG_LEGACY_PTYS is not set

# ---- 第五轮：把 regulator 框架整个关掉 ----
#
# ★ 这不是为了省空间，是资源划分本身
#
#   OWNERSHIP.md 里 Linux 是**纯计算域**：外设归 openvela。但只要
#   CONFIG_REGULATOR 还在，Linux 的 regulator 核心就会在
#   regulator_init_complete()（late_initcall）里把**所有没有消费者的
#   稳压器关掉** —— 而在 AMP 下，openvela 用的那些轨在 Linux 眼里全都
#   没有消费者。
#
#   这个坑已经踩到两次，而且两次的现场都不像电源问题：
#
#     1. openvela 访问 DSI 拿到 synchronous external abort
#        （ESR 0x96000010，FAR 0x27d80000）—— 总线拒绝，因为
#        vdd_logic_s0 被当成没人用关掉了。当时的处理是在 DTS 里把
#        vdd_logic_s0 / vdd_cpu_lit_s0 钉成 always-on。
#
#     2. 屏幕黑掉。openvela 侧一切正常（/dev/fb0 720x1280、VOP2 寄存器
#        回读正确、kickpi_ui 在跑），但屏上没有画面。原因是 PMIC 上还有
#        vcc_mipidcphy0 / vcca_1v8_s0 / vdda_0v75_s0 这些轨，DSI 的
#        D-PHY 要用，而 Linux 的 dtb 里 dsi 是 disabled、phy 驱动也被裁掉了,
#        于是它们统统"没有消费者"。
#
#   逐条钉 always-on 是打地鼠：每次 openvela 多用一个外设，就多一条轨
#   要记得钉，漏了就是一次"看起来毫不相干"的故障。把框架关掉是一次性的：
#   **Linux 不再有能力关任何一条轨。**
#
#   代价说清楚：Linux 从此不能调压，也就不能做 cpufreq/DVFS。这份配置
#   里 CPU_FREQ 和 PM_DEVFREQ 本来就是关的（AMP 下调压会动到另一个 OS
#   在用的轨），所以没有实际损失。
#
#   DTS 里 vdd_cpu_lit_s0 / vdd_logic_s0 的 always-on 保留不删 —— 它们
#   现在是惰性的，但万一有人把 REGULATOR 打开，那两条仍然是对的。
# CONFIG_REGULATOR is not set

# 关掉 REGULATOR 之后这个充电驱动链接不过（它直接调 devm_regulator_register）。
# 纯计算域不需要充电管理。
# CONFIG_CHARGER_BQ25700 is not set

# ---- 第六轮：电源域也不归 Linux 管 ----
#
# 和上面关 regulator 是同一条理由的延伸：纯计算域不该有能力关任何东西。
#
# 现象：屏幕**有背光但全黑**，而 openvela 侧证据齐全 —— VOP2 时序寄存器
# 正确（VP1 720x1280、ESMART1_REGION0_CTRL=0x00400001 使能）、/dev/fb0
# 就绪、LVGL 在跑。有背光说明面板供电和 PWM 都还在，黑的是**视频流**。
#
# 决定性的一步：在 NSH 里读 VOP2 的寄存器（0x27d00c00）—— 板子当场
# assert。而 0x27d00000 明明在 CONFIG_DEVICEIO_BASEADDR(0x20000000)+192MB
# 的 MMU 映射里，也就是说这不是"没映射"，是**总线拒绝** —— VOP 这块的
# 时钟或电源域在 Linux 起来之后没了。
#
# bootargs 里有 pd_ignore_unused，但那只挡住 genpd_power_off_unused()；
# 与其验证它到底挡没挡住，不如按定位直接把电源域框架关掉。
# CONFIG_ROCKCHIP_PM_DOMAINS is not set
# CONFIG_PM_GENERIC_DOMAINS is not set
