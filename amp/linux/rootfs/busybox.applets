# k7 initramfs 的 busybox：从 allnoconfig 起，只开这里列出的开关。
#
# 体积预算：内核（NET+RPMSG_CHAR+INITRD，-Os）6.90MB，bootamp 窗口 7.25MB，
# 留给 xz 压缩后的 initramfs 约 700KB。busybox defconfig 静态链接压完 885KB，
# 装不下，所以按用得到的挑。
#
# 每行一个 CONFIG_ 名（不带前缀），build-rootfs.sh 逐个打开。
STATIC
LFS
FEATURE_EDITING
FEATURE_TAB_COMPLETION
LONG_OPTS
# shell
ASH
SH_IS_ASH
ASH_BASH_COMPAT
ASH_JOB_CONTROL
ASH_ALIAS
ASH_ECHO
ASH_PRINTF
ASH_TEST
ASH_GETOPTS
ASH_CMDCMD
FEATURE_SH_MATH
FEATURE_SH_MATH_64
# coreutils
BASENAME
CAT
CHMOD
CP
CUT
DATE
DD
DF
DIRNAME
DU
ECHO
ENV
EXPR
FALSE
HEAD
ID
LN
LS
FEATURE_LS_FILETYPES
FEATURE_LS_FOLLOWLINKS
FEATURE_LS_RECURSIVE
FEATURE_LS_SORTFILES
FEATURE_LS_TIMESTAMPS
FEATURE_LS_USERNAME
MD5SUM
SHA256SUM
MKDIR
MV
NPROC
OD
PRINTF
PWD
RM
RMDIR
SEQ
SLEEP
FEATURE_FANCY_SLEEP
SORT
STAT
SYNC
TAIL
TEE
TEST
TEST1
TEST2
TIMEOUT
TOUCH
TR
TRUE
UNAME
UNIQ
WC
WHOAMI
YES
# procps / 进程
FREE
KILL
KILLALL
PIDOF
PS
FEATURE_PS_WIDE
TOP
FEATURE_TOP_CPU_USAGE_PERCENTAGE
FEATURE_TOP_CPU_GLOBAL_PERCENTS
FEATURE_TOP_SMP_CPU
UPTIME
NICE
TASKSET
FEATURE_TASKSET_FANCY
FEATURE_TASKSET_CPULIST
TIME
WATCH
# 文件 / 文本
FIND
FEATURE_FIND_TYPE
FEATURE_FIND_MAXDEPTH
GREP
EGREP
FEATURE_GREP_CONTEXT
XARGS
