# KICKPI-K7 AMP：Linux 侧的配置增量
#
# 用法（在 kernel-6.1 里）：
#   make ARCH=arm64 CROSS_COMPILE=<tc> rockchip_linux_defconfig rk3576.config
#   ./scripts/kconfig/merge_config.sh -m -O . .config <本文件>
#   make ARCH=arm64 CROSS_COMPILE=<tc> olddefconfig
#
# rockchip_linux_defconfig + rk3576.config 已经带了 CONFIG_ROCKCHIP_MBOX、
# CONFIG_RPMSG_ROCKCHIP_MBOX、CONFIG_RPMSG_VIRTIO —— 也就是说这条链路
# Rockchip 本来就支持，我们不用往内核里加驱动。下面只补两样：

# 让用户态能通过 /dev/rpmsgN 收发。没有它，rpmsg 只能在内核里用，
# 联调时没法从命令行发一帧。
CONFIG_RPMSG_CHAR=y

# A53 簇归 openvela，Linux 只跑 4 个核。NR_CPUS 留 8 也能跑（多出来的
# 是空位），但设成 4 能让 per-cpu 的结构小一半，也让"Linux 以为自己有
# 几个核"这件事在配置里就写死，不依赖 DTB 删节点删干净。
CONFIG_NR_CPUS=4
