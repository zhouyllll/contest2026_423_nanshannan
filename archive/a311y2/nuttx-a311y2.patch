+
+/* This file should never be included directly but, rather,
+ * only indirectly through nuttx/irq.h
+ */
+
+#ifndef __ARCH_ARM64_INCLUDE_A311Y2_IRQ_H
+#define __ARCH_ARM64_INCLUDE_A311Y2_IRQ_H
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+/* GICv3 中断号布局（与 SoC 无关的固定部分）：
+ *   0  - 15   SGI  软件生成中断
+ *   16 - 31   PPI  私有外设中断（含 Generic Timer）
+ *   32 - ...  SPI  共享外设中断  ← 中断号 = dtsi 里的 SPI 号 + 32
+ *
+ * NR_IRQS 取 512：dtsi 中出现的最大 SPI 号约 250 余，加 32 后仍有充足余量。
+ * 该值偏大只多占一点内存，偏小会让对应外设中断静默挂不上且不报错。
+ */
+
+#define NR_IRQS                 512
+
+#define A311Y2_IRQ_SPI(n)       ((n) + 32)
+
+/* UART（来源：amlogic-s6.dtsi，uart_b: serial@7a000）*/
+
+#define A311Y2_IRQ_UART_B       A311Y2_IRQ_SPI(169)   /* 201，调试控制台 */
+
+#endif /* __ARCH_ARM64_INCLUDE_A311Y2_IRQ_H */
diff --git a/arch/arm64/src/a311y2/Kconfig b/arch/arm64/src/a311y2/Kconfig
new file mode 100644
index 00000000..a869970c
--- /dev/null
+++ b/arch/arm64/src/a311y2/Kconfig
@@ -0,0 +1,26 @@
+#
+# For a description of the syntax of this configuration file,
+# see the file kconfig-language.txt in the NuttX tools repository.
+#
+
+if ARCH_CHIP_A311Y2
+
+menu "Amlogic A311Y2 Peripheral Selection"
+
+config A311Y2_UART_B
+	bool "UART B (debug console)"
+	default y
+	select UART0_SERIALDRIVER
+	---help---
+		Amlogic Meson UART (compatible: amlogic,meson-s4-uart)。
+		参考设计中 uart_b 为 serial0 别名，即调试控制台。
+
+		该控制器为 Amlogic 自有 IP，与 16550 / PL011 均不兼容，
+		驱动为本项目实现，寄存器规格见 docs/meson-uart-spec.md。
+
+		TODO(M1)：LogicPi A1 实际引出的是否为 uart_b，
+		需原理图或实机确认。
+
+endmenu # Amlogic A311Y2 Peripheral Selection
+
+endif # ARCH_CHIP_A311Y2
