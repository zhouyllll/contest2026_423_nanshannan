+#ifndef __ARCH_ARM64_SRC_A311Y2_HARDWARE_A311Y2_MEMORYMAP_H
+#define __ARCH_ARM64_SRC_A311Y2_HARDWARE_A311Y2_MEMORYMAP_H
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+#include <arch/chip/chip.h>
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+/* 外设基址。来源：Linux 主线 amlogic-s6.dtsi 各节点的 reg 属性
+ * （GPL-2.0+ OR MIT，按 MIT 分支使用）。
+ *
+ * 全部落在 CONFIG_DEVICEIO_BASEADDR(0xfe000000) + 32MB 的映射范围内；
+ * 新增外设地址时先确认这一点，否则 MMU 不建映射，访问时直接异常。
+ */
+
+/* APB 总线基址。dtsi: apb: bus@fe000000，ranges 长度 0x480000 */
+
+#define A311Y2_APB_BASE        0xfe000000
+
+/* UART。dtsi: uart_b: serial@7a000（相对 apb），寄存器区长 0x18。
+ *
+ * uart_b 是板级 dts 中 serial0 的别名，为参考设计的调试控制台。
+ * TODO(M1)：LogicPi A1 实际引出的是否为 uart_b，需原理图或实机确认。
+ */
+
+#define A311Y2_UART_B_BASE     (A311Y2_APB_BASE + 0x7a000)   /* 0xfe07a000 */
+
+#endif /* __ARCH_ARM64_SRC_A311Y2_HARDWARE_A311Y2_MEMORYMAP_H */
