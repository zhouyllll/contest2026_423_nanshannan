@@ -0,0 +1,115 @@
+/****************************************************************************
+ * arch/arm64/include/a311y2/chip.h
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Licensed to the Apache Software Foundation (ASF) under one or more
