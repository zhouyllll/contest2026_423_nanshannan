+ *
+ *   http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+ * WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.  See the
+ * License for the specific language governing permissions and limitations
+ * under the License.
+ *
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include "arm64_macro.inc"
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+    .file    "a311y2_lowputc.S"
+
+/* Amlogic Meson UART (uart_b) 基址。
+ *
+ * 汇编阶段取不到 C 头文件的宏，只能写字面量。
+ * ★ 本值必须与 hardware/a311y2_memorymap.h 的 A311Y2_UART_B_BASE
+ *   保持一致（apb 0xfe000000 + 0x7a000）。
+ *
+ * ★ 这是全项目第一个向外吐字符的地方。M1 调试时若此处都出不了字符，
+ *   说明问题在加载地址、异常向量或 MMU，而不在串口本身。
+ *
+ * U-Boot 已把串口配好，early print 阶段无需初始化，
+ * 只要轮询 TX_FULL 再写 WFIFO 即可。
+ */
+
+#define UART_BASE_ADDRESS   0xfe07a000
+
+#define UART_WFIFO          0x00      /* 发送数据寄存器 */
+#define UART_STATUS         0x0c      /* 状态寄存器 */
+#define UART_STAT_TX_FULL   (1 << 21) /* 发送 FIFO 满 */
+
+/****************************************************************************
+ * Assembly Macros
+ ****************************************************************************/
+
+/* 等待发送 FIFO 不满 */
+
+.macro early_uart_ready xb, wt
+1:
+    ldr   \wt, [\xb, #UART_STATUS]   /* 读 STATUS */
+    tst   \wt, #UART_STAT_TX_FULL    /* 检查 TX_FULL(bit 21) */
+    b.ne  1b                         /* 满则继续等 */
+.endm
+
+/* 写入一个字符 */
+
+.macro early_uart_transmit xb, wt
+    str   \wt, [\xb, #UART_WFIFO]    /* 写 WFIFO */
+.endm
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/* void arm64_lowputc(char ch) —— 由 C 代码调用 */
+
+GTEXT(arm64_lowputc)
+SECTION_FUNC(text, arm64_lowputc)
+    ldr   x15, =UART_BASE_ADDRESS
+    early_uart_ready x15, w2
+    early_uart_transmit x15, w0
+    ret
