+ * distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+ * WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.  See the
+ * License for the specific language governing permissions and limitations
+ * under the License.
+ *
+ ****************************************************************************/
+
+#ifndef __ARCH_ARM64_INCLUDE_A311Y2_CHIP_H
+#define __ARCH_ARM64_INCLUDE_A311Y2_CHIP_H
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+/* ==========================================================================
+ * Amlogic A311Y2 (LogicPi A1) platform constants.
+ *
+ * 数据来源：Linux 主线 arch/arm64/boot/dts/amlogic/amlogic-s6.dtsi
+ *          （许可证 GPL-2.0+ OR MIT，按 MIT 分支使用，与 Apache-2.0 兼容）
+ *
+ * 参考平台的确定：厂商手册确认 LogicPi A1 为四核 Cortex-A510，遍历主线全部
+ * Amlogic dtsi 后，唯一匹配的是 amlogic-s6.dtsi（S905X5 家族）。
+ * 交叉验证：其 GICR 长度 0x80000 / 0x20000 = 4 核，与四核 A510 自洽。
+ *
+ * ⚠️ S905X5(S6) 与 A311Y2 是不同产品名，属强旁证而非证据。
+ * 上板后须按 RECON.md A5 导出真实设备树逐项复核。
+ * ==========================================================================
+ */
+
+/* Number of bytes in x kibibytes/mebibytes/gibibytes */
+
+#define KB(x)           ((x) << 10)
+#define MB(x)           (KB(x) << 10)
+#define GB(x)           (MB(UINT64_C(x)) << 10)
+
+/* Generic Interrupt Controller v3: Distributor and Redistributor
+ * dtsi: interrupt-controller@ff200000, reg = <0xff200000 0x10000>,
+ *                                            <0xff240000 0x80000>
+ */
+
+#define CONFIG_GICD_BASE          0xff200000
+#define CONFIG_GICR_BASE          0xff240000
+#define CONFIG_GICR_OFFSET        0x20000
+
+/* Memory map: RAM and Device I/O
+ *
+ * DDR 物理起始为 0，但 0 到加载地址之间是 ATF/BL31 的保留区
+ * （dtsi 中 secmon_reserved 为 27MiB @ 0x05000000），不应映射。
+ * 这里从镜像加载地址开始映射，与 openvela 其他 arm64 端口的做法一致。
+ *
+ * TODO(M1)：512MB 为保守取值。LogicPi A1 实配 8GB LPDDR5，
+ * 待实机确认可用范围后放大。偏小只是用不满内存，不影响启动。
+ */
+
+#define CONFIG_RAMBANK1_ADDR      0x08000000
+#define CONFIG_RAMBANK1_SIZE      MB(512)
+
+/* Device I/O：覆盖 apb 总线(0xfe000000 + 0x480000) 与 GIC(0xff2xxxxx)。
+ * 取 0xfe000000 起 32MB，上界 0x100000000，两者均落在范围内。
+ */
+
+#define CONFIG_DEVICEIO_BASEADDR  0xfe000000
+#define CONFIG_DEVICEIO_SIZE      MB(32)
+
+/* U-Boot loads the image at this address.
+ *
+ * TODO(M1)：占位值，必须以实机 U-Boot 的 kernel_addr_r 为准
+ * （上板 printenv 可查）。Amlogic 平台常见值与 Rockchip 不同，不可沿用前例。
+ *
+ * ★ 本值必须与三处保持一致，改一处就要改三处：
+ *   1. 这里的 CONFIG_LOAD_BASE
+ *   2. 板级 configs/nsh/defconfig 的 CONFIG_RAM_START
+ *   3. 板级 scripts/dramboot.ld 的起始地址
+ * 用 scripts/check-addr.sh 校验。
+ */
+
+#define CONFIG_LOAD_BASE          0x08080000
+
+#define MPID_TO_CLUSTER_ID(mpid)  ((mpid) & ~0xff)
+
+/****************************************************************************
+ * Assembly Macros
+ ****************************************************************************/
+
+#ifdef __ASSEMBLY__
+
+.macro  get_cpu_id xreg0
+  mrs    \xreg0, mpidr_el1
+  ubfx   \xreg0, \xreg0, #0, #8
+.endm
+
+#endif /* __ASSEMBLY__ */
+
+#endif /* __ARCH_ARM64_INCLUDE_A311Y2_CHIP_H */
