+ * this work for additional information regarding copyright ownership.  The
+ * ASF licenses this file to you under the Apache License, Version 2.0 (the
+ * "License"); you may not use this file except in compliance with the
+ * License.  You may obtain a copy of the License at
+ *
+ *   http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+ * WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.  See the
+ * License for the specific language governing permissions and limitations
+ * under the License.
+ *
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <sys/types.h>
+#include <stdint.h>
+#include <stdbool.h>
+#include <errno.h>
+#include <debug.h>
+
+#include <nuttx/arch.h>
+#include <nuttx/irq.h>
+#include <nuttx/serial/serial.h>
+#include <nuttx/spinlock.h>
+
+#include <arch/chip/chip.h>
+
+#include "arm64_arch.h"
+#include "arm64_internal.h"
+#include "a311y2_serial.h"
+#include "hardware/a311y2_memorymap.h"
+#include "hardware/a311y2_uart.h"
+
+#ifdef USE_SERIALDRIVER
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+/* uart_b 映射到 NuttX 的 UART0 槽位 */
+
+#define CONSOLE_DEV     g_uart_b_port
+#define TTYS0_DEV       g_uart_b_port
+
+/****************************************************************************
+ * Private Types
+ ****************************************************************************/
+
+struct a311y2_uart_s
+{
+  uintptr_t  base;      /* 控制器基址 */
+  uint32_t   baud;      /* 配置的波特率 */
+  uint32_t   clk;       /* 时钟源频率 */
+  int        irq;       /* 中断号 */
+  uint8_t    bits;      /* 数据位 */
+  bool       stopbits2; /* true: 2 个停止位 */
+  bool       parity_en; /* 校验使能 */
+  bool       parity_odd;/* true: 奇校验 */
+  spinlock_t lock;
+};
+
+/****************************************************************************
+ * Private Function Prototypes
+ ****************************************************************************/
+
+static int  a311y2_setup(struct uart_dev_s *dev);
+static void a311y2_shutdown(struct uart_dev_s *dev);
+static int  a311y2_attach(struct uart_dev_s *dev);
+static void a311y2_detach(struct uart_dev_s *dev);
+static int  a311y2_ioctl(struct file *filep, int cmd, unsigned long arg);
+static int  a311y2_receive(struct uart_dev_s *dev, unsigned int *status);
+static void a311y2_rxint(struct uart_dev_s *dev, bool enable);
+static bool a311y2_rxavailable(struct uart_dev_s *dev);
+static void a311y2_send(struct uart_dev_s *dev, int ch);
+static void a311y2_txint(struct uart_dev_s *dev, bool enable);
+static bool a311y2_txready(struct uart_dev_s *dev);
+static bool a311y2_txempty(struct uart_dev_s *dev);
+
+/****************************************************************************
+ * Private Data
+ ****************************************************************************/
+
+static const struct uart_ops_s g_uart_ops =
+{
+  .setup       = a311y2_setup,
+  .shutdown    = a311y2_shutdown,
+  .attach      = a311y2_attach,
+  .detach      = a311y2_detach,
+  .ioctl       = a311y2_ioctl,
+  .receive     = a311y2_receive,
+  .rxint       = a311y2_rxint,
+  .rxavailable = a311y2_rxavailable,
+  .send        = a311y2_send,
+  .txint       = a311y2_txint,
+  .txready     = a311y2_txready,
+  .txempty     = a311y2_txempty,
+};
+
+static char g_uart_b_rxbuf[CONFIG_UART0_RXBUFSIZE];
+static char g_uart_b_txbuf[CONFIG_UART0_TXBUFSIZE];
+
+static struct a311y2_uart_s g_uart_b_priv =
+{
+  .base       = A311Y2_UART_B_BASE,
+  .baud       = CONFIG_UART0_BAUD,
+  .clk        = MESON_UART_XTAL_FREQ,
+  .irq        = A311Y2_IRQ_UART_B,
+  .bits       = CONFIG_UART0_BITS,
+  .stopbits2  = CONFIG_UART0_2STOP != 0,
+  .parity_en  = CONFIG_UART0_PARITY != 0,
+  .parity_odd = CONFIG_UART0_PARITY == 1,
+  .lock       = SP_UNLOCKED,
+};
+
+static struct uart_dev_s g_uart_b_port =
+{
+#ifdef CONFIG_UART0_SERIAL_CONSOLE
+  .isconsole = true,
+#endif
+  .recv      =
+  {
+    .size    = CONFIG_UART0_RXBUFSIZE,
+    .buffer  = g_uart_b_rxbuf,
+  },
+  .xmit      =
+  {
+    .size    = CONFIG_UART0_TXBUFSIZE,
+    .buffer  = g_uart_b_txbuf,
+  },
+  .ops       = &g_uart_ops,
+  .priv      = &g_uart_b_priv,
+};
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+static inline uint32_t a311y2_getreg(struct a311y2_uart_s *priv,
+                                     unsigned int offset)
+{
+  return getreg32(priv->base + offset);
+}
+
+static inline void a311y2_putreg(struct a311y2_uart_s *priv,
+                                 unsigned int offset, uint32_t value)
+{
+  putreg32(value, priv->base + offset);
+}
+
+static inline void a311y2_modifyreg(struct a311y2_uart_s *priv,
+                                    unsigned int offset,
+                                    uint32_t clearbits, uint32_t setbits)
+{
+  uint32_t regval = a311y2_getreg(priv, offset);
+
+  regval &= ~clearbits;
+  regval |= setbits;
+  a311y2_putreg(priv, offset, regval);
+}
+
+/****************************************************************************
+ * Name: a311y2_setbaud
+ *
+ * Description:
+ *   写 REG5 设置波特率。
+ *
+ *   ★ xtal_div 取 2 而非 3 —— 该系数分 SoC，取错波特率差 50%，
+ *   表现为串口出字符但全是乱码。详见 docs/meson-uart-spec.md。
+ *
+ ****************************************************************************/
+
+static void a311y2_setbaud(struct a311y2_uart_s *priv)
+{
+  uint32_t regval;
+
+  /* 切波特率前等发送真正完成。只看 TX_EMPTY 会在最后一个字节
+   * 还在移位时就返回，必须与 XMIT_BUSY 组合判断。
+   */
+
+  while ((a311y2_getreg(priv, MESON_UART_STATUS) &
+          (UART_STAT_TX_EMPTY | UART_STAT_XMIT_BUSY)) != UART_STAT_TX_EMPTY);
+
+  regval  = MESON_UART_BAUD_DIV(priv->clk, priv->baud) & UART_BAUD_DIV_MASK;
+  regval |= UART_BAUD_USE | UART_BAUD_XTAL | UART_BAUD_XTAL_DIV2;
+
+  a311y2_putreg(priv, MESON_UART_REG5, regval);
+}
+
+/****************************************************************************
+ * Name: a311y2_interrupt
+ *
+ * Description:
+ *   中断服务程序。
+ *
+ *   ★ 本控制器的中断是边沿触发（dtsi: IRQ_TYPE_EDGE_RISING），不是常见的
+ *   电平触发。必须循环读到 RX_EMPTY 置位为止 —— 处理期间新到达的数据会
+ *   产生新边沿，若在此之前退出就会漏掉中断，导致接收假死。
+ *
+ ****************************************************************************/
+
+static int a311y2_interrupt(int irq, void *context, void *arg)
+{
+  struct uart_dev_s *dev = (struct uart_dev_s *)arg;
+  struct a311y2_uart_s *priv = dev->priv;
+  uint32_t status;
+
+  do
+    {
+      status = a311y2_getreg(priv, MESON_UART_STATUS);
+
+      /* 有错误标志先清掉，否则会持续置位 */
+
+      if ((status & UART_STAT_ERR_MASK) != 0)
+        {
+          a311y2_modifyreg(priv, MESON_UART_CONTROL, 0, UART_CTRL_CLEAR_ERR);
+          a311y2_modifyreg(priv, MESON_UART_CONTROL, UART_CTRL_CLEAR_ERR, 0);
+        }
+
+      /* 收：FIFO 非空就一直取 */
+
+      if ((status & UART_STAT_RX_EMPTY) == 0)
+        {
+          uart_recvchars(dev);
+        }
+
+      /* 发：FIFO 未满且上层有待发数据 */
+
+      if ((status & UART_STAT_TX_FULL) == 0)
+        {
+          uart_xmitchars(dev);
+        }
+
+      status = a311y2_getreg(priv, MESON_UART_STATUS);
+    }
+  while ((status & UART_STAT_RX_EMPTY) == 0);
+
+  return OK;
+}
+
+/****************************************************************************
+ * Name: a311y2_setup
+ ****************************************************************************/
+
+static int a311y2_setup(struct uart_dev_s *dev)
+{
+  struct a311y2_uart_s *priv = dev->priv;
+  irqstate_t flags;
+  uint32_t regval;
+
+  flags = spin_lock_irqsave(&priv->lock);
+
+  /* 1. 关中断 */
+
+  a311y2_modifyreg(priv, MESON_UART_CONTROL,
+                   UART_CTRL_RX_INT_EN | UART_CTRL_TX_INT_EN, 0);
+
+  /* 2. 复位收发通道并清错误（写 1 触发，随后清 0） */
+
+  a311y2_modifyreg(priv, MESON_UART_CONTROL, 0,
+                   UART_CTRL_TX_RST | UART_CTRL_RX_RST | UART_CTRL_CLEAR_ERR);
+  a311y2_modifyreg(priv, MESON_UART_CONTROL,
+                   UART_CTRL_TX_RST | UART_CTRL_RX_RST | UART_CTRL_CLEAR_ERR,
+                   0);
+
+  /* 3. 帧格式。注意 DATA_LEN 编码不是位宽数值本身：0 代表 8 位 */
+
+  regval = a311y2_getreg(priv, MESON_UART_CONTROL);
+  regval &= ~(UART_CTRL_DATA_MASK | UART_CTRL_STOP_MASK |
+              UART_CTRL_PARITY_EN | UART_CTRL_PARITY_TYPE);
+
+  switch (priv->bits)
+    {
+      case 5:  regval |= UART_CTRL_DATA_5BIT; break;
+      case 6:  regval |= UART_CTRL_DATA_6BIT; break;
+      case 7:  regval |= UART_CTRL_DATA_7BIT; break;
+      default: regval |= UART_CTRL_DATA_8BIT; break;
+    }
+
+  regval |= priv->stopbits2 ? UART_CTRL_STOP_2SB : UART_CTRL_STOP_1SB;
+
+  if (priv->parity_en)
+    {
+      regval |= UART_CTRL_PARITY_EN;
+      if (priv->parity_odd)
+        {
+          regval |= UART_CTRL_PARITY_TYPE;
+        }
+    }
+
+  /* 调试串口无硬件流控，使用两线模式 */
+
+  regval |= UART_CTRL_TWO_WIRE_EN;
+  a311y2_putreg(priv, MESON_UART_CONTROL, regval);
+
+  /* 4. 波特率 */
+
+  a311y2_setbaud(priv);
+
+  /* 5. 中断阈值：收到 1 字节即触发，发送 FIFO 降到 0 时触发 */
+
+  a311y2_putreg(priv, MESON_UART_MISC,
+                UART_MISC_RECV_IRQ(1) | UART_MISC_XMIT_IRQ(0));
+
+  /* 6. 使能收发 */
+
+  a311y2_modifyreg(priv, MESON_UART_CONTROL, 0,
+                   UART_CTRL_TX_EN | UART_CTRL_RX_EN);
+
+  spin_unlock_irqrestore(&priv->lock, flags);
+  return OK;
+}
+
+/****************************************************************************
+ * Name: a311y2_shutdown
+ ****************************************************************************/
+
+static void a311y2_shutdown(struct uart_dev_s *dev)
+{
+  struct a311y2_uart_s *priv = dev->priv;
+
+  a311y2_modifyreg(priv, MESON_UART_CONTROL,
+                   UART_CTRL_TX_EN | UART_CTRL_RX_EN |
+                   UART_CTRL_RX_INT_EN | UART_CTRL_TX_INT_EN, 0);
+}
+
+/****************************************************************************
+ * Name: a311y2_attach
+ ****************************************************************************/
+
+static int a311y2_attach(struct uart_dev_s *dev)
+{
+  struct a311y2_uart_s *priv = dev->priv;
+  int ret;
+
+  ret = irq_attach(priv->irq, a311y2_interrupt, dev);
+  if (ret == OK)
+    {
+      up_enable_irq(priv->irq);
+    }
+
+  return ret;
+}
+
+/****************************************************************************
+ * Name: a311y2_detach
+ ****************************************************************************/
+
+static void a311y2_detach(struct uart_dev_s *dev)
+{
+  struct a311y2_uart_s *priv = dev->priv;
+
+  up_disable_irq(priv->irq);
+  irq_detach(priv->irq);
+}
+
+/****************************************************************************
+ * Name: a311y2_ioctl
+ ****************************************************************************/
+
+static int a311y2_ioctl(struct file *filep, int cmd, unsigned long arg)
+{
+  /* TODO(M2)：termios 支持（改波特率与帧格式）。
+   * M1 阶段控制台参数固定，暂不需要。
+   */
+
+  UNUSED(filep);
+  UNUSED(cmd);
+  UNUSED(arg);
+  return -ENOTTY;
+}
+
+/****************************************************************************
+ * Name: a311y2_receive
+ ****************************************************************************/
+
+static int a311y2_receive(struct uart_dev_s *dev, unsigned int *status)
+{
+  struct a311y2_uart_s *priv = dev->priv;
+  uint32_t regval;
+
+  regval  = a311y2_getreg(priv, MESON_UART_STATUS);
+  *status = regval & UART_STAT_ERR_MASK;
+
+  return (int)(a311y2_getreg(priv, MESON_UART_RFIFO) & 0xff);
+}
+
+/****************************************************************************
+ * Name: a311y2_rxint
+ ****************************************************************************/
+
+static void a311y2_rxint(struct uart_dev_s *dev, bool enable)
+{
+  struct a311y2_uart_s *priv = dev->priv;
+
+  if (enable)
+    {
+      a311y2_modifyreg(priv, MESON_UART_CONTROL, 0, UART_CTRL_RX_INT_EN);
+    }
+  else
+    {
+      a311y2_modifyreg(priv, MESON_UART_CONTROL, UART_CTRL_RX_INT_EN, 0);
+    }
+}
+
+/****************************************************************************
+ * Name: a311y2_rxavailable
+ ****************************************************************************/
+
+static bool a311y2_rxavailable(struct uart_dev_s *dev)
+{
+  struct a311y2_uart_s *priv = dev->priv;
+
+  return (a311y2_getreg(priv, MESON_UART_STATUS) &
+          UART_STAT_RX_EMPTY) == 0;
+}
+
+/****************************************************************************
+ * Name: a311y2_send
+ ****************************************************************************/
+
+static void a311y2_send(struct uart_dev_s *dev, int ch)
+{
+  struct a311y2_uart_s *priv = dev->priv;
+
+  a311y2_putreg(priv, MESON_UART_WFIFO, (uint32_t)ch & 0xff);
+}
+
+/****************************************************************************
+ * Name: a311y2_txint
+ ****************************************************************************/
+
+static void a311y2_txint(struct uart_dev_s *dev, bool enable)
+{
+  struct a311y2_uart_s *priv = dev->priv;
+  irqstate_t flags;
+
+  if (enable)
+    {
+      flags = enter_critical_section();
+      a311y2_modifyreg(priv, MESON_UART_CONTROL, 0, UART_CTRL_TX_INT_EN);
+
+      /* 发送 FIFO 未满时立即触发一次，避免等不到边沿 */
+
+      uart_xmitchars(dev);
+      leave_critical_section(flags);
+    }
+  else
+    {
+      a311y2_modifyreg(priv, MESON_UART_CONTROL, UART_CTRL_TX_INT_EN, 0);
+    }
+}
+
+/****************************************************************************
+ * Name: a311y2_txready
+ ****************************************************************************/
+
+static bool a311y2_txready(struct uart_dev_s *dev)
+{
+  struct a311y2_uart_s *priv = dev->priv;
+
+  return (a311y2_getreg(priv, MESON_UART_STATUS) & UART_STAT_TX_FULL) == 0;
+}
+
+/****************************************************************************
+ * Name: a311y2_txempty
+ *
+ * Description:
+ *   发送是否真正完成。TX_EMPTY 置位仅表示 FIFO 空，最后一个字节可能仍在
+ *   移位寄存器中，故必须与 XMIT_BUSY 组合判断。
+ *
+ ****************************************************************************/
+
+static bool a311y2_txempty(struct uart_dev_s *dev)
+{
+  struct a311y2_uart_s *priv = dev->priv;
+  uint32_t regval = a311y2_getreg(priv, MESON_UART_STATUS);
+
+  return (regval & (UART_STAT_TX_EMPTY | UART_STAT_XMIT_BUSY)) ==
+         UART_STAT_TX_EMPTY;
+}
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: arm64_earlyserialinit
+ ****************************************************************************/
+
+void arm64_earlyserialinit(void)
+{
+  /* U-Boot 已完成串口配置，early 阶段无需重新初始化，
+   * 直接沿用即可打印。见 docs/meson-uart-spec.md 第 7 节。
+   */
+
+#ifdef CONSOLE_DEV
+  CONSOLE_DEV.isconsole = true;
+  a311y2_setup(&CONSOLE_DEV);
+#endif
+}
+
+/****************************************************************************
+ * Name: arm64_serialinit
+ ****************************************************************************/
+
+void arm64_serialinit(void)
+{
+  uart_register("/dev/console", &CONSOLE_DEV);
+  uart_register("/dev/ttyS0", &TTYS0_DEV);
+}
+
+/****************************************************************************
+ * Name: up_putc
+ ****************************************************************************/
+
+void up_putc(int ch)
+{
+  struct a311y2_uart_s *priv = g_uart_b_port.priv;
+
+  while ((a311y2_getreg(priv, MESON_UART_STATUS) & UART_STAT_TX_FULL) != 0);
+
+  a311y2_putreg(priv, MESON_UART_WFIFO, (uint32_t)ch & 0xff);
+}
+
+#endif /* USE_SERIALDRIVER */
