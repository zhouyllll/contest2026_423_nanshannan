diff --git a/board/kickpi-k7/configs/amp-dual/defconfig b/board/kickpi-k7/configs/amp-dual/defconfig
index 1cce8e2..51d6647 100644
--- a/board/kickpi-k7/configs/amp-dual/defconfig
+++ b/board/kickpi-k7/configs/amp-dual/defconfig
@@ -56,8 +56,6 @@ CONFIG_AUDIO_ES8388=y
 CONFIG_ES8388_INPUT_CHANNEL_LINE2=y
 CONFIG_ES8388_INPUT_CHANNEL=1
 CONFIG_AUDIO_NUM_BUFFERS=4
-CONFIG_BLUETOOTH_BCM4343X=y
-CONFIG_BLUETOOTH_BCM4343X_SPEED=1500000
 CONFIG_BLUETOOTH_UART=y
 CONFIG_BLUETOOTH_UART_SHIM=y
 CONFIG_BOARDCTL_RESET=y
@@ -285,3 +283,12 @@ CONFIG_LVX_USE_DEMO_CONTEST2026_423_K7DIAG=y
 CONFIG_NETDB_DNSSERVER_IPv4ADDR=0xc0a80101
 CONFIG_NETINIT_DRIPADDR=0xc0a80101
 CONFIG_NETINIT_IPADDR=0xc0a80132
+
+# ★ 蓝牙：K7 实际焊的是 SKW6621S（SDIO 0x2a320000），不是 dtsi 里抄来的
+#   Broadcom UART 模组（原厂 Android 的 SDIO ID 日志已核实）。
+#   RK3576_SKW6621S 与 BLUETOOTH_BCM4343X 互斥。Linux 侧内核没有 MMC 驱动，
+#   不会碰 SDIO 控制器；dwmmc 是轮询驱动，不用加 amp-irqs。
+CONFIG_MMCSD_SDIO=y
+CONFIG_RK3576_DWMMC=y
+CONFIG_RK3576_SKW6621S=y
+CONFIG_SDIO_BLOCKSETUP=y
