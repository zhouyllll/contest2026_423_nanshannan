# xTS 3.1.1（12h 待机）镜像的叠加配置：KASAN + showinfo。
# 用法：cat 本文件 >> nuttx/.config && make olddefconfig
#
# 原文"开启 show_info、LOW_RESOURCE_TEST=y、CONFIG_MM_KASAN=y"：本树没有
# LOW_RESOURCE_TEST 符号，且 resmonitor 的帮助写明 showinfo 不应与它同用；
# showinfo 由 SYSTEM_RESMONITOR 提供。
CONFIG_MM_KASAN=y
CONFIG_MM_KASAN_GENERIC=y
CONFIG_SYSTEM_RESMONITOR=y
# KASAN 插桩后 nuttx.bin 4,190,208 字节，打成 FIT 要超过 trust 分区的 8192 扇区
# （4,194,304 字节；后面是 U-Boot 每次启动都写的 misc，不能扩）。
# 去掉三个只在别的 xTS 用例里手动跑的测试程序，待机测试不运行它们。
# CONFIG_TESTING_OSTEST is not set
# CONFIG_TESTING_SCANFTEST is not set
# CONFIG_TESTING_CXXTEST is not set
