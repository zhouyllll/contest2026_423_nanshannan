# xTS 1.3.7（I2C 功能）叠加配置：MPU-6050 + uORB 传感器框架 + 用例。
# 用法：cat 本文件 >> nuttx/.config && make olddefconfig
#
# 原文用 BMI160，本板没有，改用手头的 MPU-6050（同为六轴 I2C 器件）。
# 用例 cmocka_driver_i2c_spi 打开的是 /dev/accel0，与具体型号无关。
CONFIG_SENSORS=y
CONFIG_USENSOR=y
CONFIG_KICKPI_K7_MPU6050=y
CONFIG_KICKPI_K7_MPU6050_I2C_BUS=7

# 用例 cmocka_driver_i2c_spi 的编译开关写死在
# apps/testing/drivers/drivertest/Makefile 里：CONFIG_SENSORS_BMI160 非空才编。
# 板上没有 BMI160，这里只是把驱动编进去让用例存在；不注册该器件，
# 用例按 -d 指定的路径读 /dev/uorb/sensor_accel0（MPU-6050）。
CONFIG_SENSORS_BMI160=y
CONFIG_SENSORS_BMI160_I2C=y
