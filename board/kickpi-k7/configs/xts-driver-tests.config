# xTS 1.3.12（cmocka_driver_rtc）+ 1.3.16（nist_sts）测试镜像的叠加配置。
# 用法：cat 本文件 >> nuttx/.config && make olddefconfig
#
# 原文还列了 CONFIG_DRIVERS_RTC、CONFIG_CMOCKA：本树没有这两个符号，
# 对应的是已打开的 CONFIG_RTC_DRIVER、CONFIG_TESTING_CMOCKA。
# RTC_ALARM / RTC_PERIODIC 需要 drivers/timers/hym8563.c 的 wdog 闹钟实现。
CONFIG_RTC_ALARM=y
CONFIG_RTC_PERIODIC=y
CONFIG_RTC_IOCTL=y
CONFIG_SIG_EVTHREAD=y
CONFIG_TESTING_NIST_STS=y
# 1.3.16：原文读 /dev/urandom。DEV_URANDOM_ARCH 让它指向本板硬件 RNG
# （chip/rk3576/rk3576_rng.c），而不是 NuttX 的软件 xorshift128。
CONFIG_DEV_URANDOM=y
CONFIG_DEV_URANDOM_ARCH=y
